// Per-position residue composition precalc, pooled over every sample (ephemeral).
// Level-neutral: used for both the aa and the nt level.
//
// Reads the per-sample composition files that each sample's job already wrote
// ([parentId, position, state] -> readCount, …) and sums them over samples:
//
//   stateHeatmap.parquet   [parentId, position, state] -> readCount, frequency
//                       (+ moleculeCount, moleculeFrequency on a UMI run)
//
// `frequency` is recomputed from the summed counts over the (parentId, position)
// column total, so each position column adds up to 1. Averaging the per-sample
// frequencies would weight every sample equally and give a different number.
//
// The parent-residue track is NOT built here — it comes from mitool via
// aggregate-parent-tables.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
aggSizing := import(":aggregate-sizing")

self.defineOutputs("stateHeatmap")

self.awaitState("InputsLocked")
self.awaitState("compositionData", "ResourceReady")

self.body(func(inputs) {
	// Sized by sample count (heatmap step) or by input, whichever is larger: the job holds
	// every per-sample composition row, so a library of many parents outgrows the sample rule.
	// The largest measured need is 37.8 bytes per input byte (1,000 parents).
	wf := aggSizing.applyStepOrInput(pt.workflow(), "heatmap", inputs.samples, inputs.aggMemGB, 80)

	hasUmi := !is_undefined(inputs.hasUmi) && inputs.hasUmi

	// Same columns and types from every sample, so the concat accepts them.
	perSampleSelect := [
		pt.col("parentId").cast("String"),
		pt.col("position").cast("String"),
		pt.col("state").cast("String"),
		pt.col("readCount").cast("Long")
	]
	if hasUmi {
		perSampleSelect = append(perSampleSelect, pt.col("moleculeCount").cast("Long"))
	}
	frames := []
	rmMap := inputs.compositionData.inputs()
	for sKey in maps.getKeys(rmMap) {
		frames = append(frames, wf.frame({
			file: rmMap[sKey],
			xsvType: "parquet"
		}, { id: "comp_" + string(len(frames)) }).select(perSampleSelect...))
	}
	ll.assert(len(frames) > 0, "no per-sample composition frames")
	perSample := len(frames) == 1 ? frames[0] : pt.concat(frames)

	cellAggs := [pt.col("readCount").sum().alias("readCount")]
	if hasUmi {
		cellAggs = append(cellAggs, pt.col("moleculeCount").sum().alias("moleculeCount"))
	}
	cells := perSample.
		groupBy("parentId", "position", "state").
		agg(cellAggs...)

	// Both sides cast to Double: the count is a Long sum, and an integer division
	// here would floor every frequency to 0.
	freqOf := func(countCol, alias) {
		return pt.col(countCol).cast("Double").
			truediv(pt.col(countCol).cast("Double").sum().over(["parentId", "position"])).
			alias(alias)
	}
	freqCols := [freqOf("readCount", "frequency")]
	if hasUmi {
		freqCols = append(freqCols, freqOf("moleculeCount", "moleculeFrequency"))
	}
	cells.withColumns(freqCols...).save("stateHeatmap.parquet")

	result := wf.run()

	return {
		stateHeatmap: result.getFile("stateHeatmap.parquet")
	}
})
