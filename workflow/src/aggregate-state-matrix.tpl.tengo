// Cross-sample state-matrix dedup for ONE position chunk (ephemeral). Level-neutral:
// used for both the aa and the nt state matrix, rendered once per chunk key per level.
//
// The state matrix is a property of the variant, so it is identical in every sample a
// variant appears in. Dedups by [variantKey, parentId, position] across samples:
//   stateMatrix.tsv  [variantKey, parentId, position] -> state
//
// (mitool names the first TSV column `variantKey` in both the aa and nt exports;
// it holds the aa/nt variant key respectively, matching the variant axis column.)
//
// `unique({ keep: "any" })` rather than groupBy().agg(first()): ptabler hardcodes
// maintain_order on groupBy, which cannot stream. `keep: "any"` is exact — the state
// matrix is a pure function of the variant, so duplicates carry identical states.
// No trailing sort: xsv.importFile sorts by axes.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")

self.defineOutputs("stateMatrix")

self.awaitState("InputsLocked")
self.awaitState("stateMatrixData", "ResourceReady")

self.body(func(inputs) {
	// [sampleId] -> this chunk's per-sample file.
	rmMap := inputs.stateMatrixData.inputs()

	// The dedup holds every distinct key in RAM (~200 B/row) and does not spill.
	// Raise DIGITS in state-matrix-chunks if a run needs more than this covers.
	// mem() must be a literal: it reaches pt.workflow-run as JSON, so a formula
	// cannot survive the crossing.
	wf := pt.workflow().
		inHeavyQueue().
		mem("48GiB")

	frames := []
	for sKey in maps.getKeys(rmMap) {
		// inferSchema:false -> every column String, so empty and populated per-sample
		// TSVs share one schema and the concat cannot hit a type mismatch.
		frames = append(frames, wf.frame({
			file: rmMap[sKey],
			xsvType: "tsv"
		}, { id: "sm_" + string(len(frames)), inferSchema: false }))
	}
	ll.assert(len(frames) > 0, "no state-matrix frames")

	merged := frames[0]
	if len(frames) > 1 {
		merged = pt.concat(frames)
	}

	merged.
		unique({ subset: ["variantKey", "parentId", "position"], keep: "any" }).
		save("stateMatrix.tsv", { xsvType: "tsv" })

	result := wf.run()

	return {
		stateMatrix: result.getFile("stateMatrix.tsv")
	}
})
