// Cross-sample state-matrix dedup (ephemeral). Level-neutral: one invocation per level.
//
//   stateMatrix.tsv  [variantKey, parentId, position] -> state
//
// The rows of one (variant, parent) pair are identical in every sample that holds the
// pair. Each pair gets one owner sample, the first that keeps it, and only the owner's
// rows pass. The matrix rows stream through the join; the job holds the pair list,
// never the matrix.
//
// The owner is per pair, not per variant: mitool gives a variant the parent of the
// first nt variant it sees in a sample, so one variant can carry different parents in
// different samples, and each parent's rows must survive.
//
// The abundance tables carry the variants each sample keeps, so the productive and
// export-only-matched filters reach the matrix through them. The variants tables carry
// the parent of each variant in that sample.
//
// (mitool names the first TSV column `variantKey` in both the aa and nt exports;
// it holds the aa/nt variant key respectively, matching the variant axis column.)
// No trailing sort: xsv.importFile sorts by axes.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
aggSizing := import(":aggregate-sizing")

self.defineOutputs("stateMatrix")

self.awaitState("InputsLocked")
self.awaitState("stateMatrixData", "ResourceReady")
self.awaitState("abundanceData", "ResourceReady")
self.awaitState("variantsData", "ResourceReady")

self.body(func(inputs) {
	// All three keyed [sampleId].
	smMap := inputs.stateMatrixData.inputs()
	abMap := inputs.abundanceData.inputs()
	varMap := inputs.variantsData.inputs()
	// The variants tables name the key column after the level.
	keyCol := inputs.variantsKeyColumn

	// Sized by sample count: dedup step. The job streams the matrices and holds only the
	// (variant, parent) owner list.
	wf := aggSizing.applyStep(pt.workflow(), "dedup", len(smMap), inputs.aggMemGB)

	keyFrames := []
	smFrames := []
	for sKey in maps.getKeys(smMap) {
		ll.assert(!is_undefined(abMap[sKey]), "no abundance table for sample %v", sKey)
		ll.assert(!is_undefined(varMap[sKey]), "no variants table for sample %v", sKey)
		idx := len(smFrames)
		kept := wf.frame({
			file: abMap[sKey],
			xsvType: "parquet"
		}, { id: "kept_" + string(idx) }).select(
			pt.col("variantKey").cast("String").alias("variantKey")
		)
		parents := wf.frame({
			file: varMap[sKey],
			xsvType: "tsv"
		}, { id: "parents_" + string(idx), inferSchema: false }).select(
			pt.col(keyCol).alias("variantKey"),
			pt.col("parentId")
		)
		keyFrames = append(keyFrames, kept.
			join(parents, { how: "inner", on: ["variantKey"] }).
			select(pt.col("variantKey"), pt.col("parentId"), pt.lit(idx).alias("__owner")))
		// inferSchema:false -> every column String, so empty and populated per-sample
		// TSVs share one schema and the concat cannot hit a type mismatch.
		smFrames = append(smFrames, wf.frame({
			file: smMap[sKey],
			xsvType: "tsv"
		}, { id: "sm_" + string(idx), inferSchema: false }).withColumns(
			pt.lit(idx).alias("__owner")
		))
	}
	ll.assert(len(smFrames) > 0, "no state-matrix frames")

	keys := keyFrames[0]
	matrix := smFrames[0]
	if len(smFrames) > 1 {
		keys = pt.concat(keyFrames)
		matrix = pt.concat(smFrames)
	}

	owners := keys.groupBy("variantKey", "parentId").agg(pt.col("__owner").min().alias("__owner"))

	matrix.
		join(owners, { how: "inner", on: ["variantKey", "parentId", "__owner"] }).
		select(pt.col("variantKey"), pt.col("parentId"), pt.col("position"), pt.col("state")).
		save("stateMatrix.tsv", { xsvType: "tsv" })

	result := wf.run()

	return {
		stateMatrix: result.getFile("stateMatrix.tsv")
	}
})
