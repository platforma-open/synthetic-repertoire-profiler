// Per sample (one FASTQ pair = one processColumn group over lane/readIndex):
//   parse -> .mic -> repertoire analyze -> variant / aa / state-matrix TSVs + qc.json
// Then a cross-sample aggregate turns the per-sample variants.tsv into one
// PColumn frame per distinct variant (sequence, label, total reads, sample count).

wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
file := import("@platforma-sdk/workflow-tengo:file")
maps := import("@platforma-sdk/workflow-tengo:maps")
render := import("@platforma-sdk/workflow-tengo:render")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
strings := import("@platforma-sdk/workflow-tengo:strings")
columnSpecs := import(":column-specs")
regionConfig := import(":region-config")
smChunks := import(":state-matrix-chunks")
json := import("json")

prerunTpl := assets.importTemplate(":prerun")
repertoirePipelineTpl := assets.importTemplate(":repertoire-pipeline")
vdjAutoRegionsTpl := assets.importTemplate(":vdj-auto-regions")
aggregateVariantsTpl := assets.importTemplate(":aggregate-variants")
aggregateStateMatrixTpl := assets.importTemplate(":aggregate-state-matrix")
mergeStateMatrixTpl := assets.importTemplate(":merge-state-matrix")
computeStateHeatmapTpl := assets.importTemplate(":compute-state-heatmap")
aggregateRegionAnnotationTpl := assets.importTemplate(":aggregate-region-annotation")
aggregateParentTablesTpl := assets.importTemplate(":aggregate-parent-tables")
aggregateLinkersTpl := assets.importTemplate(":aggregate-linkers")
aggregateKnownTpl := assets.importTemplate(":aggregate-known")
processKnownSetTpl := assets.importTemplate(":process-known-set")
computeQcTpl := assets.importTemplate(":compute-qc")

// Resource allocation defaults. User overrides via perProcessMemGB/perProcessCPUs.
// Xsv imports carry no defaults: they run an unsized pt.workflow() and are sized
// from input volume by the SDK (see aggregate-state-matrix).
defaultMitoolMemGB := 16 // per-sample mitool parse + analyze
defaultMitoolCPUs := 4

// Prerun drives the file uploads (parent FASTA / known-set TSVs) so they finish
// during staging.
wf.setPreRun(prerunTpl)

wf.prepare(func(args) {
	return { resolvedInput: wf.resolve(args.input) }
})

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()

	traceLabel := args.customBlockLabel
	if traceLabel == "" { traceLabel = args.defaultBlockLabel }
	if traceLabel == "" { traceLabel = "Amplicon Profiling" }

	inputSpec := args.resolvedInput.spec
	inputData := args.resolvedInput.data
	fileExtension := inputSpec.domain["pl7.app/fileExtension"]

	// Opt-in nucleotide-level export (off by default). Gates the nt state matrix
	// computation (via params) and every nt-related column added to the exported
	// `variants` frame below. When off, only the aa level is exported.
	exportNt := args.exportNt

	// Restrict the exported `variants` frame to variants that matched a known entry.
	// The model only sets this true when a known set is present. When true, every
	// variant-keyed family in the export (per-sample abundance, per-variant
	// properties, state matrices, linkers, distances) is filtered per level —
	// nt keeps assignStatus == ASSIGNED, aa keeps variants carrying a knownAaKey.
	// A level with no match signal (nt with only an aa set) exports empty.
	exportOnlyKnown := !is_undefined(args.exportOnlyKnown) && args.exportOnlyKnown
	// nt has a match signal only when an nt known set was supplied.
	hasNtKnown := !is_undefined(args.knownNtFileHandle)

	// Materialize the parent reference and known-set files. Pasted FASTA travels
	// as a string written to a file inside the per-sample command; uploaded handles
	// are imported via file.importFile. Prerun already drove the uploads, so
	// file.importFile here resolves straight to the stored blob.
	parentFastaStr := undefined
	parentFile := undefined
	if args.parentInputMode == "fastaSequence" {
		parentFastaStr = args.parentSequence
	} else {
		parentFile = file.importFile(args.parentFileHandle).file
	}

	knownNtFile := undefined
	if !is_undefined(args.knownNtFileHandle) {
		knownNtFile = file.importFile(args.knownNtFileHandle).file
	}
	knownAaFile := undefined
	if !is_undefined(args.knownAaFileHandle) {
		knownAaFile = file.importFile(args.knownAaFileHandle).file
	}

	// Region scheme. Two sources of the mitool `--parent-regions` overlay:
	//   - vdjAutoDetect ON: the workflow infers every parent's FR1–FR4 from germline
	//     (repseqio) and writes the overlay to a FILE; region names are the fixed VDJ
	//     set (regionConfig.vdjAuto). The manual parentRegions is ignored (model
	//     suppresses parentRegionsJson in this mode).
	//   - OFF: the manual overlay JSON string drives both mitool and the region names.
	rc := undefined
	parentRegionsJson := undefined
	parentRegionsFile := undefined
	if args.vdjAutoDetect {
		rc = regionConfig.vdjAuto()
		autoRun := render.create(vdjAutoRegionsTpl, {
			parentFastaStr: parentFastaStr,
			parentFile: parentFile
		})
		parentRegionsFile = autoRun.output("parentRegionsJson", 24 * 60 * 60 * 1000)
	} else {
		rc = regionConfig.analyze(args.parentRegionsJson)
		parentRegionsJson = args.parentRegionsJson
	}

	// Gates the molecule columns. Must match the workflow's own hasUmi: an Xsv spec
	// naming a column the parquet does not carry fails the import.
	hasUmi := !is_undefined(args.umi)

	// Modality: one pipeline produces two genuinely different kinds of repertoire —
	// a VDJ one from antibody/TCR parents, a general amplicon one from designed
	// libraries, phage pools and deep mutational scans. Derived from the region
	// configuration (germline auto-detect on, or any parent on the `vdj` scheme),
	// NOT from a control of its own: choosing the VDJ region scheme is already the
	// user stating they are working on a V-domain, so a separate control would ask
	// the same question twice and could be set to contradict the regions it
	// describes. A run therefore has exactly one modality, by construction.
	modality := rc.isVdj ? "vdj" : "amplicon"
	// Shared by every run-scoped spec below — see runScopeDomain.
	runScope := columnSpecs.runScopeDomain(blockId, modality)

	params := maps.clone({
		fileExtension: fileExtension,
		pattern: args.tagPattern,
		patternParts: args.patternParts,
		// Absent without a UMI; presence is what switches the chain on downstream.
		umi: args.umi,
		minReadsPerConsensus: args.minReadsPerConsensus,
		minUmiQuality: args.minUmiQuality,
		exportNt: exportNt,
		exportOnlyKnown: exportOnlyKnown,
		parentFastaStr: parentFastaStr,
		parentFile: parentFile,
		parentRegionsJson: parentRegionsJson,
		parentRegionsFile: parentRegionsFile,
		emitRegionAnnotation: rc.hasRegions,
		knownNtFile: knownNtFile,
		knownAaFile: knownAaFile,
		knownNtIdColumn: args.knownNtIdColumn,
		knownNtSequenceColumn: args.knownNtSequenceColumn,
		knownAaIdColumn: args.knownAaIdColumn,
		knownAaSequenceColumn: args.knownAaSequenceColumn,
		// Per-fragment mutation-load filter → mitool align step (-Malign.filter.*).
		maxMutations: args.maxMutations,
		maxMutationFraction: args.maxMutationFraction,
		// Per-variant aa mutation-load filter → mitool call-mutations step (-Mcall-mutations.*).
		maxAaMutations: args.maxAaMutations,
		maxAaMutationFraction: args.maxAaMutationFraction,
		// Quality gates → mitool align step (-Malign.filter.minBaseQuality) and
		// assemble step (-Massemble.minVariantQuality). Unlike the filters above these
		// are ON by mitool default, so "absent" means 5 / 20, not off.
		minBaseQuality: args.minBaseQuality,
		minVariantQuality: args.minVariantQuality
	}, { removeUndefs: true })

	// One File-valued PColumn per analyze output, keyed by sampleId.
	fileOutput := func(outputName) {
		return {
			type: "Resource",
			spec: {
				kind: "PColumn",
				name: "pl7.app/repertoire/" + outputName,
				domain: runScope,
				valueType: "File"
			},
			name: outputName,
			path: [outputName]
		}
	}

	ntVariantAxis := columnSpecs.variantKeyAxisSpec(runScope, "nucleotide", "Variant nt")
	aaVariantAxis := columnSpecs.variantKeyAxisSpec(runScope, "aminoacid", "Variant aa")

	// Mutation-count axis (X of the mutation-load distribution), per level.
	ntMutationCountAxis := columnSpecs.mutationCountAxisSpec("nucleotide", "Nt mutations")
	aaMutationCountAxis := columnSpecs.mutationCountAxisSpec("aminoacid", "AA mutations")

	ntKnownAxis := columnSpecs.knownVariantKeyAxisSpec(runScope, "nucleotide", "Known variant nt")
	aaKnownAxis := columnSpecs.knownVariantKeyAxisSpec(runScope, "aminoacid", "Known variant aa")

	// Per-sample Xsv target: axes are the data axes; processColumn prepends the
	// sampleId partition, yielding [sampleId, …] PARTITIONED by sampleId — the
	// shape downstream blocks (clonotype-browser) split on. No mem/cpu override —
	// the import runs an unsized pt.workflow() and is sized from input volume
	// (see aggregate-state-matrix).
	xsvTarget := func(name, path, axes, columns) {
		return {
			type: "Xsv",
			xsvType: "parquet",
			settings: {
				axes: axes,
				columns: columns,
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			name: name,
			path: [path]
		}
	}
	// Per-variant abundance (nt + aa).
	ntAbundanceXsv := xsvTarget("ntAbundanceXsv", "ntAbundance", [ntVariantAxis], columnSpecs.perSampleAbundanceColumns(hasUmi))
	aaAbundanceXsv := xsvTarget("aaAbundanceXsv", "aaAbundance", [aaVariantAxis], columnSpecs.perSampleAbundanceColumns(hasUmi))
	// Known-level per-sample abundance + synonymous spread (always declared;
	// the per-sample parquets are empty when nothing is assigned — added to the
	// frame below only when a known set was supplied).
	knownNtAbundanceXsv := xsvTarget("knownNtAbundanceXsv", "knownNtAbundance", [ntKnownAxis], columnSpecs.knownAbundanceColumns(hasUmi))
	knownAaAbundanceXsv := xsvTarget("knownAaAbundanceXsv", "knownAaAbundance", [aaKnownAxis], columnSpecs.knownAbundanceColumns(hasUmi))
	// Declared-member synonymous spread, keyed by the known-aa entity.
	aaConvergenceXsv := xsvTarget("aaConvergenceXsv", "aaConvergence", [aaKnownAxis], columnSpecs.convergenceColumns())
	// Per-sample mutation-load histogram — feeds the in-block plot, not exported.
	ntMutationHistogramXsv := xsvTarget("ntMutationHistogramXsv", "ntMutationHistogram", [ntMutationCountAxis], columnSpecs.mutationHistogramColumns("nucleotide"))
	aaMutationHistogramXsv := xsvTarget("aaMutationHistogramXsv", "aaMutationHistogram", [aaMutationCountAxis], columnSpecs.mutationHistogramColumns("aminoacid"))

	// Per-sample step reports (ResourceMap keyed [step, format]; processColumn
	// prepends sampleId). Feeds the sample report panel (json charts + txt views)
	// and the Main-page Alignments cell (align/json).
	reportsOutput := {
		type: "ResourceMap",
		name: "reports",
		spec: {
			kind: "PColumn",
			name: "pl7.app/repertoire/report",
			domain: runScope,
			valueType: "File",
			axesSpec: [{
				type: "String",
				name: "pl7.app/repertoire/report/step",
				annotations: { "pl7.app/label": "Pipeline step" }
			}, {
				type: "String",
				name: "pl7.app/repertoire/report/format",
				annotations: { "pl7.app/label": "Report format" },
				domain: { "pl7.app/dense": string(json.encode(["json"])) }
			}]
		}
	}

	// Per-step logs (ResourceMap keyed [step]; processColumn prepends sampleId).
	// `ResourceMap`, not `Resource`+`path`: the per-sample template returns a built
	// resource map, which a `Resource` target would pass through as one opaque resource.
	stepLogsOutput := {
		type: "ResourceMap",
		name: "stepLogs",
		spec: {
			kind: "PColumn",
			name: "pl7.app/log",
			domain: runScope,
			valueType: "Log",
			axesSpec: [{
				type: "String",
				name: "pl7.app/repertoire/log/step",
				annotations: { "pl7.app/label": "Pipeline step" }
			}]
		}
	}

	targetOutputs := [
		// Parse output — surfaced for deduplication. mitool parse writes the .mic
		// in non-deterministic record order, so it must be retained by content
		// hash to survive reruns without a CID conflict (see repertoire-pipeline).
		fileOutput("parsedMic"),
		fileOutput("variantsTsv"),
		fileOutput("aaVariantsTsv"),
		fileOutput("regionAnnotationTsv"),
		fileOutput("aaParentResiduesTsv"),
		fileOutput("ntParentResiduesTsv"),
		fileOutput("parentsTsv"),
		fileOutput("qcJson"),
		fileOutput("paramsJson"),
		fileOutput("ntAbundance"),
		fileOutput("aaAbundance"),
		fileOutput("knownDesignedNt"),
		fileOutput("knownDesignedAa"),
		fileOutput("aaConvergence"),
		fileOutput("qcRow"),
		reportsOutput,
		ntAbundanceXsv,
		aaAbundanceXsv,
		ntMutationHistogramXsv,
		aaMutationHistogramXsv,
		knownNtAbundanceXsv,
		knownAaAbundanceXsv,
		aaConvergenceXsv,
		stepLogsOutput
	]
	// State matrix, split by position chunk inside the per-sample job: one plain File
	// output per level per chunk key (see state-matrix-chunks outputName).
	for chunkKey in smChunks.keys() {
		targetOutputs = append(targetOutputs, fileOutput(smChunks.outputName("aa", chunkKey)))
		targetOutputs = append(targetOutputs, fileOutput(smChunks.outputName("nt", chunkKey)))
	}

	perSampleResults := pframes.processColumn(
		{ spec: inputSpec, data: inputData },
		repertoirePipelineTpl,
		targetOutputs,
		{
			aggregate: [
				{ name: "pl7.app/sequencing/lane", optional: true },
				{ name: "pl7.app/sequencing/readIndex", optional: true }
			],
			passAggregationAxesNames: true,
			// Residual group key (== sampleId) flows to the per-sample template so
			// it can stamp the QC row.
			passKey: true,
			traceSteps: [{
				type: "milaboratories.synthetic-repertoire-profiler",
				id: blockId,
				importance: 20,
				label: traceLabel
			}],
			extra: { params: params },
			metaExtra: {
				mitoolMemGB: is_undefined(args.perProcessMemGB) ? defaultMitoolMemGB : args.perProcessMemGB,
				mitoolCPUs: is_undefined(args.perProcessCPUs) ? defaultMitoolCPUs : args.perProcessCPUs
			}
		}
	)

	// Cross-sample / cross-variant properties (nt + aa): one ephemeral reads the
	// per-sample abundance parquets (totals) + raw variant TSVs (sample-independent
	// metadata) and emits per-variant property tables.
	aggVarsRun := render.createEphemeral(aggregateVariantsTpl, {
		ntAbundanceData: perSampleResults.outputData("ntAbundance"),
		aaAbundanceData: perSampleResults.outputData("aaAbundance"),
		variantsTsvData: perSampleResults.outputData("variantsTsv"),
		aaVariantsTsvData: perSampleResults.outputData("aaVariantsTsv"),
		ntRegionCols: rc.ntRegionNames,
		aaRegionCols: rc.aaRegionNames,
		hasUmi: hasUmi
	})
	importProps := func(file, axis, isAa, regionNames) {
		return xsv.importFile(
			file,
			"tsv",
			{
				axes: [axis],
				columns: columnSpecs.aggregatedColumns(isAa ? "aminoacid" : "nucleotide", isAa, regionNames, rc.completeFeatureName, hasUmi),
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
	}
	// The properties TSVs are also read by the composition heat map below (for the
	// cross-sample per-variant read total), so hold the file handles.
	ntPropsTsv := aggVarsRun.output("ntProperties")
	aaPropsTsv := aggVarsRun.output("aaProperties")
	// aa properties always; nt properties only when exported (skip the import
	// entirely otherwise — nothing downstream consumes them).
	ntPropsCols := undefined
	if exportNt {
		ntPropsCols = importProps(ntPropsTsv, ntVariantAxis, false, rc.ntRegionNames)
	}
	aaPropsCols := importProps(aaPropsTsv, aaVariantAxis, true, rc.aaRegionNames)

	// State matrix [variantKey, parentId, position] -> state, deduped cross-sample.
	// aa always; nt only when nt export is enabled (its per-sample TSV is an empty
	// placeholder otherwise — see repertoire-pipeline). Same ephemeral aggregate
	// serves both levels.
	// Returns the imported PColumns AND the aggregated TSV: the same table feeds the
	// in-block composition heat map (compute-state-heatmap), which reads it as a
	// frame rather than round-tripping the imported column back out.
	importStateMatrix := func(levelPrefix, variantAxis, alphabet, posLabel) {
		// One dedup job per position chunk, then a streaming concat of the results.
		mergeInputs := {}
		for idx, key in smChunks.keys() {
			chunkRun := render.createEphemeral(aggregateStateMatrixTpl, {
				stateMatrixData: perSampleResults.outputData(smChunks.outputName(levelPrefix, key))
			})
			mergeInputs["chunk" + string(idx)] = chunkRun.output("stateMatrix")
		}
		smRun := render.createEphemeral(mergeStateMatrixTpl, mergeInputs)
		stateMatrixTsv := smRun.output("stateMatrix")
		return {
			tsv: stateMatrixTsv,
			cols: xsv.importFile(
				stateMatrixTsv,
				"tsv",
				{
					axes: [
						variantAxis,
						columnSpecs.parentIdAxisSpec("Parent"),
						columnSpecs.positionAxisSpec(alphabet, posLabel)
					],
					columns: columnSpecs.stateMatrixColumns(alphabet),
					storageFormat: "Parquet",
					partitionKeyLength: 0
				},
				{ splitDataAndSpec: true }
			)
		}
	}
	aaStateMatrix := importStateMatrix("aa", aaVariantAxis, "aminoacid", "Position aa")
	aaStateMatrixCols := aaStateMatrix.cols
	ntStateMatrix := undefined
	ntStateMatrixCols := undefined
	if exportNt {
		ntStateMatrix = importStateMatrix("nt", ntVariantAxis, "nucleotide", "Position nt")
		ntStateMatrixCols = ntStateMatrix.cols
	}

	// Region membership [parentId, position(aa)] -> region, deduped cross-sample.
	// Only when the run defines regions (else there is no annotation to import).
	regionAnnotationCols := undefined
	// Held so the composition heat map can import the same table under its own
	// column identity (see heatmapRegionColumns) instead of borrowing this one.
	regionAnnotationTsv := undefined
	if rc.hasRegions {
		regionAnnRun := render.createEphemeral(aggregateRegionAnnotationTpl, {
			regionAnnotationData: perSampleResults.outputData("regionAnnotationTsv")
		})
		regionAnnotationTsv = regionAnnRun.output("regionAnnotation")
		regionAnnotationCols = xsv.importFile(
			regionAnnotationTsv,
			"tsv",
			{
				axes: [
					columnSpecs.parentIdAxisSpec("Parent"),
					columnSpecs.positionAxisSpec("aminoacid", "Position aa")
				],
				columns: columnSpecs.regionAnnotationColumns(rc.hasSubRegions),
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
	}

	// Parent tables, deduped cross-sample. Imported ONCE per level and added to both frames —
	// the exported variants frame and the in-block heat-map frame — so the plot and the export
	// can never show a different parent.
	importParentResidues := func(perSampleOutput, alphabet, posLabel) {
		run := render.createEphemeral(aggregateParentTablesTpl, {
			tableData: perSampleResults.outputData(perSampleOutput),
			keys: ["parentId", "position"],
			valueCols: ["residue"]
		})
		return xsv.importFile(
			run.output("table"),
			"tsv",
			{
				axes: [
					columnSpecs.parentIdAxisSpec("Parent"),
					columnSpecs.positionAxisSpec(alphabet, posLabel)
				],
				columns: columnSpecs.parentResidueColumns(alphabet),
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
	}
	aaParentResidueCols := importParentResidues("aaParentResiduesTsv", "aminoacid", "Position aa")
	ntParentResidueCols := undefined
	if exportNt {
		ntParentResidueCols = importParentResidues("ntParentResiduesTsv", "nucleotide", "Position nt")
	}

	// Whole parent sequence, keyed [parentId]. One aggregate, then one import per level rather
	// than one import with both column specs, so each level carries its own level trace.
	parentSeqRun := render.createEphemeral(aggregateParentTablesTpl, {
		tableData: perSampleResults.outputData("parentsTsv"),
		keys: ["parentId"],
		valueCols: ["ntSequence", "aaSequence"]
	})
	importParentSequence := func(alphabet, column) {
		return xsv.importFile(
			parentSeqRun.output("table"),
			"tsv",
			{
				axes: [columnSpecs.parentIdAxisSpec("Parent")],
				columns: columnSpecs.parentSequenceColumns(alphabet, column),
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
	}
	aaParentSeqCols := importParentSequence("aminoacid", "aaSequence")
	ntParentSeqCols := undefined
	if exportNt {
		ntParentSeqCols = importParentSequence("nucleotide", "ntSequence")
	}

	// Linkers (nt→aa, parent→nt, parent→aa). One-side leads in the axes.
	linkersRun := render.createEphemeral(aggregateLinkersTpl, {
		variantsTsvData: perSampleResults.outputData("variantsTsv"),
		aaVariantsTsvData: perSampleResults.outputData("aaVariantsTsv"),
		// Export-only-matched filter: nt linkers keep assignStatus == ASSIGNED
		// (empty when no nt known set), aa linkers keep rows with a knownAaKey.
		exportOnlyKnown: exportOnlyKnown,
		hasNtKnown: hasNtKnown
	})
	importLinker := func(file, axes, name) {
		return xsv.importFile(
			file,
			"tsv",
			{
				axes: axes,
				columns: columnSpecs.linkerColumns(name),
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
	}
	// nt→aa and parent→nt linkers reference the nt variant axis, so they are
	// imported only when nt export is enabled. parent→aa always.
	ntToAaCols := undefined
	parentNtCols := undefined
	if exportNt {
		ntToAaCols = importLinker(
			linkersRun.output("ntToAa"),
			[
				columnSpecs.variantKeyAxisSpec(runScope, "aminoacid", "Variant aa", "aaKey"),
				columnSpecs.variantKeyAxisSpec(runScope, "nucleotide", "Variant nt", "ntKey")
			],
			"pl7.app/repertoire/aaToNt"
		)
		parentNtCols = importLinker(
			linkersRun.output("parentNt"),
			[
				columnSpecs.parentIdAxisSpec("Parent"),
				columnSpecs.variantKeyAxisSpec(runScope, "nucleotide", "Variant nt", "ntKey")
			],
			"pl7.app/repertoire/parentLink"
		)
	}
	parentAaCols := importLinker(
		linkersRun.output("parentAa"),
		[
			columnSpecs.parentIdAxisSpec("Parent"),
			columnSpecs.variantKeyAxisSpec(runScope, "aminoacid", "Variant aa", "aaKey")
		],
		"pl7.app/repertoire/parentLink"
	)

	// Assemble the variant PColumns into a frame with provenance. The nt and aa
	// abundance anchors are otherwise spec-identical, so a high-importance level
	// trace step ("NT Variants" / "AA Variants") distinguishes them in downstream
	// dataset pickers.
	blockStep := {
		type: "milaboratories.synthetic-repertoire-profiler",
		id: blockId,
		importance: 20,
		label: traceLabel
	}
	levelStep := func(alphabet, label) {
		return {
			type: "milaboratories.synthetic-repertoire-profiler.level",
			id: blockId + "." + alphabet,
			importance: 80,
			label: label
		}
	}
	baseTrace := pSpec.makeTrace(inputSpec, blockStep)
	ntTrace := pSpec.makeTrace(inputSpec, blockStep, levelStep("nt", "NT Variants"))
	aaTrace := pSpec.makeTrace(inputSpec, blockStep, levelStep("aa", "AA Variants"))

	variantsPfBuilder := pframes.pFrameBuilder()
	// Per-sample abundance ([sampleId, variantKey], partitioned by sampleId) — the
	// downstream anchor. nt (gated by exportNt) + aa (always).
	if exportNt {
		for columnName in perSampleResults.listXsvColumns("ntAbundanceXsv") {
			variantsPfBuilder.add(
				"perSampleNt/" + columnName,
				ntTrace.inject(perSampleResults.outputSpec("ntAbundanceXsv", columnName)),
				perSampleResults.outputData("ntAbundanceXsv", columnName)
			)
		}
	}
	for columnName in perSampleResults.listXsvColumns("aaAbundanceXsv") {
		variantsPfBuilder.add(
			"perSampleAa/" + columnName,
			aaTrace.inject(perSampleResults.outputSpec("aaAbundanceXsv", columnName)),
			perSampleResults.outputData("aaAbundanceXsv", columnName)
		)
	}
	// Per-variant cross-sample columns ([variantKey]): label, sequence, totals,
	// (aa) ntVariantCount. nt gated by exportNt.
	if exportNt {
		for k, v in ntPropsCols {
			variantsPfBuilder.add("perVariantNt/" + k, ntTrace.inject(v.spec), v.data)
		}
	}
	for k, v in aaPropsCols {
		variantsPfBuilder.add("perVariantAa/" + k, aaTrace.inject(v.spec), v.data)
	}
	// aa state matrix — exported in the variants frame for the companion heat-map
	// block. No in-block view by design; visualization is the companion block's job.
	for k, v in aaStateMatrixCols {
		variantsPfBuilder.add("stateMatrixAa/" + k, aaTrace.inject(v.spec), v.data)
	}
	// nt state matrix — same, only when nt export is enabled.
	if exportNt {
		for k, v in ntStateMatrixCols {
			variantsPfBuilder.add("stateMatrixNt/" + k, ntTrace.inject(v.spec), v.data)
		}
	}
	// Parent residue + parent sequence. Exported so a downstream block can locate a mutated
	// cell in the state matrix instead of guessing the parent from the matrix itself.
	for k, v in aaParentResidueCols {
		variantsPfBuilder.add("parentResidueAa/" + k, aaTrace.inject(v.spec), v.data)
	}
	for k, v in aaParentSeqCols {
		variantsPfBuilder.add("parentSequenceAa/" + k, aaTrace.inject(v.spec), v.data)
	}
	if exportNt {
		for k, v in ntParentResidueCols {
			variantsPfBuilder.add("parentResidueNt/" + k, ntTrace.inject(v.spec), v.data)
		}
		for k, v in ntParentSeqCols {
			variantsPfBuilder.add("parentSequenceNt/" + k, ntTrace.inject(v.spec), v.data)
		}
	}
	// Region membership (parent-derived; colours the aa state-matrix heat map).
	if !is_undefined(regionAnnotationCols) {
		for k, v in regionAnnotationCols {
			variantsPfBuilder.add("regionAnnotation/" + k, baseTrace.inject(v.spec), v.data)
		}
	}
	// Linkers — into the exported variants frame for downstream traversal. The
	// nt↔aa linker and parent→nt linker reference the nt variant axis, so they are
	// meaningful only when the nt columns are exported (gated). parent→aa always.
	if exportNt {
		for k, v in ntToAaCols {
			variantsPfBuilder.add("aaToNt/" + k, baseTrace.inject(v.spec), v.data)
		}
		for k, v in parentNtCols {
			variantsPfBuilder.add("parentNt/" + k, ntTrace.inject(v.spec), v.data)
		}
	}
	for k, v in parentAaCols {
		variantsPfBuilder.add("parentAa/" + k, aaTrace.inject(v.spec), v.data)
	}

	// --- Mutation-histogram plot frame ----------------------------------------
	mutationHistogramPfBuilder := pframes.pFrameBuilder()
	addMutationHistogram := func(prefix, xsvName, trace) {
		for columnName in perSampleResults.listXsvColumns(xsvName) {
			mutationHistogramPfBuilder.add(
				prefix + columnName,
				trace.inject(perSampleResults.outputSpec(xsvName, columnName)),
				perSampleResults.outputData(xsvName, columnName)
			)
		}
	}
	// aa always; nt only when nt export is on (same gating as the rest of the block).
	if exportNt {
		addMutationHistogram("nt/", "ntMutationHistogramXsv", ntTrace)
	}
	addMutationHistogram("aa/", "aaMutationHistogramXsv", aaTrace)
	mutationHistogramPf := mutationHistogramPfBuilder.build()

	// --- Per-position residue composition heat-map frame ----------------------
	// In-block view (an output, not an export): position × residue, coloured by
	// pooled read count or per-position residue frequency, keyed by parent. The
	// per-variant state matrix and abundance stay the exported contract; this is
	// the plot built from them.
	//
	// parentId stays an AXIS of every column here rather than being filtered to one
	// parent: positions from different parents are different coordinate systems, so
	// the page maps parentId to a grouping (single parent) or to tabs (several).
	stateHeatmapPfBuilder := pframes.pFrameBuilder()
	addStateHeatmap := func(prefix, stateMatrixTsv, propertiesTsv, alphabet, posLabel, trace, parentResidueCols) {
		hmRun := render.createEphemeral(computeStateHeatmapTpl, {
			stateMatrixTsv: stateMatrixTsv,
			propertiesTsv: propertiesTsv
		})
		hmCols := xsv.importFile(
			hmRun.output("stateHeatmap"),
			"tsv",
			{
				axes: [
					columnSpecs.parentIdAxisSpec("Parent"),
					columnSpecs.positionAxisSpec(alphabet, posLabel),
					columnSpecs.stateAxisSpec(alphabet)
				],
				columns: columnSpecs.stateHeatmapColumns(alphabet),
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		for k, v in hmCols {
			stateHeatmapPfBuilder.add(prefix + k, trace.inject(v.spec), v.data)
		}
		// Parent-sequence track, on the same [parentId, position] key as the cells.
		for k, v in parentResidueCols {
			stateHeatmapPfBuilder.add(prefix + "parent/" + k, trace.inject(v.spec), v.data)
		}
	}
	// aa always; nt only when nt export is on (same gating as the rest of the block).
	addStateHeatmap("aa/", aaStateMatrix.tsv, aaPropsTsv, "aminoacid", "Position aa", aaTrace, aaParentResidueCols)
	if exportNt {
		addStateHeatmap("nt/", ntStateMatrix.tsv, ntPropsTsv, "nucleotide", "Position nt", ntTrace, ntParentResidueCols)
	}
	// Region membership as a second [parentId, position] track. The cross-sample
	// region table is aa-positioned, so it rides the aa map only. Imported here a
	// second time under the plot's own column identity (alphabet domain, so it is
	// pinned to the aa level inside a frame that may also hold nt positions) rather
	// than borrowing the column built for the downstream export.
	if !is_undefined(regionAnnotationTsv) {
		hmRegionCols := xsv.importFile(
			regionAnnotationTsv,
			"tsv",
			{
				axes: [
					columnSpecs.parentIdAxisSpec("Parent"),
					columnSpecs.positionAxisSpec("aminoacid", "Position aa")
				],
				columns: columnSpecs.heatmapRegionColumns("aminoacid", rc.hasSubRegions),
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		for k, v in hmRegionCols {
			stateHeatmapPfBuilder.add("aa/region/" + k, aaTrace.inject(v.spec), v.data)
		}
	}
	stateHeatmapPf := stateHeatmapPfBuilder.build()

	// --- known-set overlay (when an nt and/or aa known set was supplied) -------
	// Exact-match (budget 0) overlay derived from the assigned variants: known
	// linkers, distance-to-nearest, and per-level known tables (id + sequence +
	// linked abundance). knownVariantKey = hash of the (matched == known)
	// sequence. nt assignment needs --known; aa assignment runs with --known-aa
	// or is derived from --known. Metadata / unmatched designed entries /
	// convergence are handled separately.
	knownVariantsNtPf := undefined
	knownVariantsAaPf := undefined
	if !is_undefined(knownNtFile) || !is_undefined(knownAaFile) {
		knownRun := render.createEphemeral(aggregateKnownTpl, {
			variantsTsvData: perSampleResults.outputData("variantsTsv"),
			aaVariantsTsvData: perSampleResults.outputData("aaVariantsTsv"),
			knownDesignedNtData: perSampleResults.outputData("knownDesignedNt"),
			knownDesignedAaData: perSampleResults.outputData("knownDesignedAa"),
			aaConvergenceData: perSampleResults.outputData("aaConvergence"),
			// When exporting only matched variants, the distance-to-known columns
			// (variant-axis keyed, part of the export) are restricted to matched
			// variants too, so they carry no keys absent from the filtered repertoire.
			exportOnlyKnown: exportOnlyKnown
		})
		importKnown := func(file, axes, columns) {
			return xsv.importFile(file, "tsv", {
				axes: axes,
				columns: columns,
				storageFormat: "Parquet",
				partitionKeyLength: 0
			}, { splitDataAndSpec: true })
		}

		// Dynamic import-column specs for the mapped metadata fields. The column
		// id is the sanitized header — must match process-known-set's aliases.
		metadataImportColumns := func(descriptors) {
			cols := []
			for c in descriptors {
				cid := strings.substituteSpecialCharacters(c.header)
				cols = append(cols, {
					column: cid,
					id: cid,
					allowNA: true,
					naRegex: "",
					spec: {
						name: "pl7.app/knownVariantMetadata/" + cid,
						valueType: c.type,
						annotations: {
							"pl7.app/label": c.header,
							"pl7.app/table/visibility": "default"
						}
					}
				})
			}
			return cols
		}

		// Read one level's known TSV and import its metadata columns, keyed by the
		// known-variant axis (so it joins the known linker). undefined when no
		// metadata was mapped.
		importKnownMetadata := func(knownFile, assignedKeysFile, seqCol, descriptors, axis) {
			if is_undefined(descriptors) || len(descriptors) == 0 {
				return undefined
			}
			metaRun := render.createEphemeral(processKnownSetTpl, {
				knownFile: knownFile,
				assignedKeysFile: assignedKeysFile,
				sequenceColumn: seqCol,
				metadataColumns: descriptors
			})
			return importKnown(metaRun.output("metadata"), [axis], metadataImportColumns(descriptors))
		}
		// nt overlay — only when an nt known set ran (otherwise the nt tables are
		// empty; skip importing them).
		if !is_undefined(knownNtFile) {
			// knownNtCols (matched only) feeds the export overlay; knownNtMetaCols
			// feeds both the export overlay and the block-local table. The combined
			// block-local table itself uses knownNtAll (all designed) — built below.
			// The linker and distance columns are export-only — inside the exportNt gate.
			knownNtCols := importKnown(knownRun.output("knownNt"), [ntKnownAxis], columnSpecs.knownVariantColumns("nucleotide", true))
			knownNtMetaCols := importKnownMetadata(knownNtFile, knownRun.output("knownNt"), args.knownNtSequenceColumn, args.knownNtMetadata, ntKnownAxis)

			// The nt known-set overlay is exported only when nt export is enabled;
			// its columns key on the nt (variant/known) axes. The block-local Known
			// Variants (NT) table below is built regardless — it is a view driven by
			// the uploaded known-nt set, not the export toggle.
			if exportNt {
				knownLinkerNtCols := importKnown(
					knownRun.output("knownLinkerNt"),
					[ntKnownAxis, columnSpecs.variantKeyAxisSpec(runScope, "nucleotide", "Variant nt", "ntKey")],
					columnSpecs.linkerColumns("pl7.app/repertoire/knownLink")
				)
				ntDistanceCols := importKnown(knownRun.output("ntDistance"), [ntVariantAxis], columnSpecs.knownDistanceColumns(false))
				for k, v in knownLinkerNtCols {
					variantsPfBuilder.add("knownLinkerNt/" + k, ntTrace.inject(v.spec), v.data)
				}
				for k, v in ntDistanceCols {
					variantsPfBuilder.add("knownNt/" + k, ntTrace.inject(v.spec), v.data)
				}
				for k, v in knownNtCols {
					variantsPfBuilder.add("knownVariantNt/" + k, ntTrace.inject(v.spec), v.data)
				}
				if !is_undefined(knownNtMetaCols) {
					for k, v in knownNtMetaCols {
						variantsPfBuilder.add("knownMetaNt/" + k, ntTrace.inject(v.spec), v.data)
					}
				}
			}

			// knownAaToNt linker (designed nt→aa) + known nt× sample abundance —
			// both reference the nt known axis, exported only when nt export is on.
			if exportNt {
				// The knownAaToNt linker's two axes are both knownVariantKey (aa
				// one-side leads, nt many-side follows) — distinct TSV column names
				// per axis. (Synonymous count + convergence summary are keyed
				// [knownVariantKey(aa)] and handled in the aa block / table below.)
				aaKnownAxisLink := columnSpecs.knownVariantKeyAxisSpec(runScope, "aminoacid", "Known variant aa", "knownKeyAa")
				ntKnownAxisLink := columnSpecs.knownVariantKeyAxisSpec(runScope, "nucleotide", "Known variant nt", "knownKeyNt")
				knownAaToNtCols := importKnown(
					knownRun.output("knownAaToNt"),
					[aaKnownAxisLink, ntKnownAxisLink],
					columnSpecs.linkerColumns("pl7.app/repertoire/knownAaToNt")
				)
				for k, v in knownAaToNtCols {
					variantsPfBuilder.add("knownAaToNt/" + k, baseTrace.inject(v.spec), v.data)
				}

				// Known nt× sample abundance.
				for columnName in perSampleResults.listXsvColumns("knownNtAbundanceXsv") {
					variantsPfBuilder.add(
						"knownAbundanceNt/" + columnName,
						ntTrace.inject(perSampleResults.outputSpec("knownNtAbundanceXsv", columnName)),
						perSampleResults.outputData("knownNtAbundanceXsv", columnName)
					)
				}
			}

			// Block-local Known Variants (NT) table — EVERY designed nt entry, with
			// the matched abundance left-joined (blank readCountTotal/sampleCount for
			// undetected designed entries). Merges the former "Known Variants (NT)"
			// and "Unmatched Designed (NT)" pages into one view. Metadata is
			// matched-only (undetected rows show blank metadata cells). The exported
			// overlay above stays matched-only (knownNtCols).
			knownNtAllCols := importKnown(
				knownRun.output("knownNtAll"),
				[ntKnownAxis],
				columnSpecs.knownVariantColumns("nucleotide", true, true)
			)
			knownVariantsNtPfBuilder := pframes.pFrameBuilder()
			for k, v in knownNtAllCols {
				knownVariantsNtPfBuilder.add(k, ntTrace.inject(v.spec), v.data)
			}
			if !is_undefined(knownNtMetaCols) {
				for k, v in knownNtMetaCols {
					knownVariantsNtPfBuilder.add("meta_" + k, ntTrace.inject(v.spec), v.data)
				}
			}
			knownVariantsNtPf = knownVariantsNtPfBuilder.build()
		}

		// aa overlay — runs whenever any known set is present (aa is derived from
		// the nt set when only --known is given).
		knownLinkerAaCols := importKnown(
			knownRun.output("knownLinkerAa"),
			[aaKnownAxis, columnSpecs.variantKeyAxisSpec(runScope, "aminoacid", "Variant aa", "aaKey")],
			columnSpecs.linkerColumns("pl7.app/repertoire/knownLink")
		)
		aaDistanceCols := importKnown(knownRun.output("aaDistance"), [aaVariantAxis], columnSpecs.knownDistanceColumns(true))
		knownAaCols := importKnown(knownRun.output("knownAa"), [aaKnownAxis], columnSpecs.knownVariantColumns("aminoacid", true))
		knownAaMetaCols := importKnownMetadata(knownAaFile, knownRun.output("knownAa"), args.knownAaSequenceColumn, args.knownAaMetadata, aaKnownAxis)

		for k, v in knownLinkerAaCols {
			variantsPfBuilder.add("knownLinkerAa/" + k, aaTrace.inject(v.spec), v.data)
		}
		for k, v in aaDistanceCols {
			variantsPfBuilder.add("knownAa/" + k, aaTrace.inject(v.spec), v.data)
		}
		for k, v in knownAaCols {
			variantsPfBuilder.add("knownVariantAa/" + k, aaTrace.inject(v.spec), v.data)
		}
		if !is_undefined(knownAaMetaCols) {
			for k, v in knownAaMetaCols {
				variantsPfBuilder.add("knownMetaAa/" + k, aaTrace.inject(v.spec), v.data)
			}
		}
		// Known aa× sample abundance + synonymous-spread QC ([sampleId,
		// variantKey(aa)]).
		for columnName in perSampleResults.listXsvColumns("knownAaAbundanceXsv") {
			variantsPfBuilder.add(
				"knownAbundanceAa/" + columnName,
				aaTrace.inject(perSampleResults.outputSpec("knownAaAbundanceXsv", columnName)),
				perSampleResults.outputData("knownAaAbundanceXsv", columnName)
			)
		}
		for columnName in perSampleResults.listXsvColumns("aaConvergenceXsv") {
			variantsPfBuilder.add(
				"convergence/" + columnName,
				aaTrace.inject(perSampleResults.outputSpec("aaConvergenceXsv", columnName)),
				perSampleResults.outputData("aaConvergenceXsv", columnName)
			)
		}

		// Declared synonymous count + cross-sample convergence summary, both keyed
		// [knownVariantKey(aa)] — added to the export and the AA table below.
		knownSynCountCols := importKnown(knownRun.output("knownSynCount"), [aaKnownAxis], columnSpecs.knownSynCountColumns())
		knownConvergenceCols := importKnown(knownRun.output("knownConvergence"), [aaKnownAxis], columnSpecs.convergenceSummaryColumns())
		for k, v in knownSynCountCols {
			variantsPfBuilder.add("knownSynCount/" + k, aaTrace.inject(v.spec), v.data)
		}
		for k, v in knownConvergenceCols {
			variantsPfBuilder.add("knownConvergence/" + k, aaTrace.inject(v.spec), v.data)
		}

		knownVariantsAaPfBuilder := pframes.pFrameBuilder()
		for k, v in knownAaCols {
			knownVariantsAaPfBuilder.add(k, aaTrace.inject(v.spec), v.data)
		}
		if !is_undefined(knownAaMetaCols) {
			for k, v in knownAaMetaCols {
				knownVariantsAaPfBuilder.add("meta_" + k, aaTrace.inject(v.spec), v.data)
			}
		}
		for k, v in knownSynCountCols {
			knownVariantsAaPfBuilder.add("syn_" + k, aaTrace.inject(v.spec), v.data)
		}
		for k, v in knownConvergenceCols {
			knownVariantsAaPfBuilder.add("conv_" + k, aaTrace.inject(v.spec), v.data)
		}
		knownVariantsAaPf = knownVariantsAaPfBuilder.build()
	}

	variantsPf := variantsPfBuilder.build()

	// QC report frame: merge per-sample qcRow parquets into one qc.tsv, then
	// import as a [sampleId]-keyed PFrame. Surfaced as the `qc` output the model
	// resolves into the QC Report table.
	qcRun := render.createEphemeral(computeQcTpl, {
		qcRowsData: perSampleResults.outputData("qcRow")
	})
	qcColumns := xsv.importFile(
		qcRun.output("qcTable"),
		"tsv",
		columnSpecs.qcColumns(inputSpec.axesSpec[0], hasUmi),
		{ splitDataAndSpec: true }
	)
	qcPfBuilder := pframes.pFrameBuilder()
	for k, v in qcColumns {
		qcPfBuilder.add(k, baseTrace.inject(v.spec), v.data)
	}
	qcPf := qcPfBuilder.build()

	outputs := {
		// Kept reachable so the parsed .mic is persisted by content hash (dedup)
		// and recovered on rerun rather than recomputed (non-deterministic bytes).
		parsedMic: perSampleResults.outputData("parsedMic"),
		variantsTsv: perSampleResults.output("variantsTsv"),
		aaVariantsTsv: perSampleResults.output("aaVariantsTsv"),
		// outputData so the model can resolve("qcJson") + parseResourceMap it
		// (the per-sample qc.json is written at the end of analyze → its
		// presence is the per-sample "done" signal).
		qcJson: perSampleResults.outputData("qcJson"),
		paramsJson: perSampleResults.output("paramsJson"),
		// Per-sample QC metrics PFrame (sampleId axis) for the QC Report table.
		qc: pframes.exportFrame(qcPf),
		mutationHistogram: pframes.exportFrame(mutationHistogramPf),
		// Per-position residue composition heat map (position × residue, per parent).
		stateHeatmap: pframes.exportFrame(stateHeatmapPf),
		// Per-sample step reports ([sampleId, step, format] -> file) for the
		// sample report panel + Main-page Alignments cell. exportColumnData makes
		// each file a downloadable Blob (getFileHandle/getContentJson need an
		// exported file, not a raw Blob resource).
		reports: pframes.exportColumnData(perSampleResults.outputData("reports")),
		// The resource-map DATA, so the model can resolve() + parseResourceMap it
		// (a plain output() reads back as an opaque std/map).
		stepLogs: perSampleResults.outputData("stepLogs")
	}
	// Known Variants tables — present only when the matching known set ran.
	if !is_undefined(knownVariantsNtPf) {
		outputs.knownVariantsNt = pframes.exportFrame(knownVariantsNtPf)
	}
	if !is_undefined(knownVariantsAaPf) {
		outputs.knownVariantsAa = pframes.exportFrame(knownVariantsAaPf)
	}

	return {
		outputs: outputs,
		exports: {
			variants: variantsPf
		}
	}
})
