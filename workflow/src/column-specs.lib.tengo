// PColumn spec builders for the synthetic-repertoire-profiler block.
// Universal pl7.app/ names; the variant axis is distinguished by the
// pl7.app/alphabet domain (nucleotide | aminoacid).

maps := import("@platforma-sdk/workflow-tengo:maps")

json := import("json")

// Merge standard table annotations (order + visibility) onto a spec's annotations.
tableAnno := func(order, visibility, anno) {
	return maps.merge(anno, {
		"pl7.app/table/orderPriority": string(order),
		"pl7.app/table/visibility": visibility
	})
}

// The run-scoping + modality domain carried by every run-scoped spec this block
// emits — both entity axes (at both alphabets) and the File/Log-valued outputs.
//
//   blockId  — the id of the block that created the spec. Keeps the axis from
//              colliding with another run's variants.
//   modality — "vdj" | "amplicon": which kind of repertoire this run produced.
//              Declared by the producer rather than left for consumers to infer
//              from axis names, because everything here sits on the
//              modality-neutral pl7.app/variantKey axis and so carries no evidence
//              of what was made.
//
// One helper, one call per spec, so the declaration can never be present on one
// spec and absent from a sibling — a consumer that found it on the variant axis
// but not the known-variant axis could not tell "different modality" from
// "unlabelled".
runScopeDomain := func(blockId, modality) {
	return {
		"pl7.app/blockId": blockId,
		"pl7.app/repertoire/extractionRunId": blockId,
		"pl7.app/modality": modality
	}
}

// A chain id (IGHeavy, TCRBeta, …) mapped to its receptor and bare chain.
chainIdInfo := func(chainId) {
	m := {
		IGHeavy: { receptor: "IG", chain: "Heavy" },
		IGLight: { receptor: "IG", chain: "Light" },
		TCRBeta: { receptor: "TCRAB", chain: "Beta" },
		TCRAlpha: { receptor: "TCRAB", chain: "Alpha" },
		TCRDelta: { receptor: "TCRGD", chain: "Delta" },
		TCRGamma: { receptor: "TCRGD", chain: "Gamma" }
	}
	return m[chainId]
}

// Recombination of a bare chain: VDJ for Heavy/Beta/Delta, VJ for the rest.
recombinationOf := func(chain) {
	if chain == "Heavy" || chain == "Beta" || chain == "Delta" {
		return "VDJ"
	}
	return "VJ"
}

// Chain set of a two-chain receptor, VDJ chain first.
receptorChainsOf := func(receptor) {
	if receptor == "IG" {
		return "Heavy+Light"
	}
	if receptor == "TCRAB" {
		return "Beta+Alpha"
	}
	return "Delta+Gamma"
}

// The distinct bare chains in a chain-id list, each as its chainIdInfo, first-seen
// order. The order fixes which chain leads a two-chain receptor.
distinctChainInfo := func(chainIds) {
	info := []
	seen := {}
	for cid in chainIds {
		bi := chainIdInfo(cid)
		if is_undefined(seen[bi.chain]) {
			seen[bi.chain] = true
			info = append(info, bi)
		}
	}
	return info
}

// Domain for the variantKey axis: runScopeDomain plus the keys that describe the
// key itself. identitySource is always "derived" — the profiler computes the key
// from the variant's content. Under modality "vdj" the tree carries the chain
// resolution from the run's set of chain ids:
//   no chain   -> resolution "unresolved"
//   one chain  -> resolution "chain" + receptor + chain
//   two chains -> resolution "receptor" + pairing "construct" + receptor +
//                 receptorChains (an scFv construct)
// identityComponents is fixed "VDJRegion~" per chain: the key is the whole variant
// over the parent span, with no gene calls.
variantScopeDomain := func(blockId, modality, chainIds) {
	d := runScopeDomain(blockId, modality)
	d["pl7.app/identitySource"] = "derived"
	if modality != "vdj" {
		return d
	}
	info := distinctChainInfo(chainIds)
	n := len(info)
	if n == 0 {
		d["pl7.app/vdj/resolution"] = "unresolved"
		d["pl7.app/vdj/identityComponents"] = "VDJRegion~"
		return d
	}
	if n == 1 {
		d["pl7.app/vdj/resolution"] = "chain"
		d["pl7.app/vdj/receptor"] = info[0].receptor
		d["pl7.app/vdj/chain"] = info[0].chain
		d["pl7.app/vdj/identityComponents"] = "VDJRegion~"
		return d
	}
	// Two chains: a paired construct (scFv). The receptor and its chain set follow
	// from the chains, which the model has already checked share one receptor.
	d["pl7.app/vdj/resolution"] = "receptor"
	d["pl7.app/vdj/pairing"] = "construct"
	d["pl7.app/vdj/receptor"] = info[0].receptor
	d["pl7.app/vdj/receptorChains"] = receptorChainsOf(info[0].receptor)
	d["pl7.app/vdj/identityComponents"] = "VDJRegion~;VDJRegion~"
	return d
}

// Variant axis: one distinct variant sequence. `alphabet` is "nucleotide" or
// "aminoacid"; `runScope` is runScopeDomain(blockId, modality) — it scopes the
// axis to this run and declares the run's modality. Optional trailing arg
// overrides the source column name (default "variantKey") — needed for linker
// tables that carry two variant-key columns.
variantKeyAxisSpec := func(runScope, alphabet, label, ...rest) {
	col := "variantKey"
	if len(rest) > 0 {
		col = rest[0]
	}
	anno := {
		"pl7.app/label": label,
		"pl7.app/table/fontFamily": "monospace",
		"pl7.app/table/visibility": "default",
		"pl7.app/table/orderPriority": "110000"
	}
	// recombination rides with a resolved single chain on the axis (variant-key
	// doc: A under resolution = chain). It is an annotation, not a domain key. In the
	// two-chain receptor case there is no vdj/chain on the axis, so it is absent here
	// and sits on the per-chain columns instead.
	chain := runScope["pl7.app/vdj/chain"]
	if !is_undefined(chain) {
		anno["pl7.app/vdj/chain/recombination"] = recombinationOf(chain)
	}
	return {
		column: col,
		naRegex: "",
		spec: {
			name: "pl7.app/variantKey",
			type: "String",
			domain: maps.merge({ "pl7.app/alphabet": alphabet }, runScope),
			annotations: anno
		}
	}
}

// Parent (alignment-reference) axis. Run-specific values → NO domain (the domain
// annotation is reserved for project-wide enums; the parent set is per-run).
parentIdAxisSpec := func(label) {
	return {
		column: "parentId",
		naRegex: "",
		spec: {
			name: "pl7.app/repertoire/parentId",
			type: "String",
			annotations: {
				"pl7.app/label": label
			}
		}
	}
}

// Reference-position axis. String value (v2 IMGT-readiness), numbering = naive
// (the only scheme v1 emits); alphabet distinguishes the nt vs aa state matrix.
positionAxisSpec := func(alphabet, label) {
	return {
		column: "position",
		naRegex: "",
		spec: {
			name: "pl7.app/repertoire/position",
			type: "String",
			domain: {
				"pl7.app/repertoire/numbering": "naive",
				"pl7.app/alphabet": alphabet
			},
			annotations: {
				"pl7.app/label": label
			}
		}
	}
}

// State-matrix value column (encoding: letter = match/substitution,
// multi-letter = insertion, "-" = deletion). The per-position value is the
// variant's residue/base relative to the parent; labeled "Mutation State" for
// customers ("State" alone read as jargon). `alphabet` distinguishes aa vs nt.
stateMatrixColumns := func(alphabet) {
	return [{
		column: "state",
		id: "state",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/stateMatrix",
			valueType: "String",
			annotations: tableAnno(70000, "default", {
				"pl7.app/label": (alphabet == "aminoacid") ? "Mutation State aa" : "Mutation State nt",
				"pl7.app/table/fontFamily": "monospace"
			})
		}
	}]
}

// State (residue/base) axis of the per-position composition heat map — the Y axis.
// Same value alphabet as the state matrix (letter = match/substitution,
// multi-letter = insertion, "-" = deletion), but here it is a KEY rather than a
// value, because the map is indexed by residue. Block-local: this axis is a
// terminal plot dimension, not exported for downstream joins.
stateAxisSpec := func(alphabet) {
	return {
		column: "state",
		naRegex: "",
		spec: {
			name: "pl7.app/repertoire/state",
			type: "String",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: {
				"pl7.app/label": (alphabet == "aminoacid") ? "Amino Acids" : "Nucleotides",
				"pl7.app/table/fontFamily": "monospace"
			}
		}
	}
}

// Per-position composition heat-map cells, keyed [parentId, position, state]. Two
// value columns from one aggregation, so the user can switch the plotted quantity
// without a re-run:
//   readCount — reads pooled over every sample and every variant carrying the residue
//   frequency — the same sum over its (parentId, position) column total, so each
//               position column adds up to 1 (the composition readout)
// Block-local names: these are in-block plot columns, not exported, and a
// distinct name keeps them from being confused with the per-variant abundance
// columns of the same quantity.
stateHeatmapColumns := func(alphabet, hasUmi) {
	cols := []
	if hasUmi {
		cols = append(cols, {
			column: "moleculeFrequency",
			id: "state-umi-frequency",
			allowNA: false,
			spec: {
				name: "pl7.app/repertoire/stateMoleculeFrequency",
				valueType: "Double",
				domain: { "pl7.app/alphabet": alphabet },
				annotations: tableAnno(100500, "default", {
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/aggregated": "true",
					"pl7.app/abundance/normalized": "true",
					"pl7.app/label": "Residue frequency (UMIs)",
					"pl7.app/format": ".2p"
				})
			}
		}, {
			column: "moleculeCount",
			id: "state-umi-count",
			allowNA: false,
			spec: {
				name: "pl7.app/repertoire/stateMoleculeCount",
				valueType: "Long",
				domain: { "pl7.app/alphabet": alphabet },
				annotations: tableAnno(90500, "default", {
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/aggregated": "true",
					"pl7.app/abundance/normalized": "false",
					"pl7.app/label": "UMI count"
				})
			}
		})
	}
	return append(cols, {
		column: "readCount",
		id: "state-read-count",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/stateReadCount",
			valueType: "Long",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(90000, "default", {
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/aggregated": "true",
				"pl7.app/abundance/normalized": "false",
				"pl7.app/label": "Read count"
			})
		}
	}, {
		column: "frequency",
		id: "state-frequency",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/stateFrequency",
			valueType: "Double",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(100000, "default", {
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/aggregated": "true",
				"pl7.app/abundance/normalized": "true",
				"pl7.app/label": "Residue frequency",
				"pl7.app/format": ".2p"
			})
		}
	})
}

// Parent (reference) residue per position, keyed [parentId, position] — the track
// that shows the parent sequence under the heat map's position axis, and what a
// downstream block differences against to tell a mutated cell from an unmutated
// one. String value → discrete annotation coloured by residue, letter in the
// tooltip. Source column is mitool's `residue`.
parentResidueColumns := func(alphabet) {
	return [{
		column: "residue",
		id: "parent-residue",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/parentResidue",
			valueType: "String",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(70000, "default", {
				"pl7.app/label": (alphabet == "aminoacid") ? "Parent AA" : "Parent NT",
				"pl7.app/table/fontFamily": "monospace"
			})
		}
	}]
}

// The whole parent (alignment reference) sequence, keyed [parentId]. Deliberately
// NOT `pl7.app/sequence`: the per-variant sequence already holds that name with
// {feature: amplicon-sequence, alphabet}, so reusing the pair would let a
// feature-agnostic discovery pick up the reference instead of a variant.
parentSequenceColumns := func(alphabet, column) {
	return [{
		column: column,
		// Alphabet-scoped so the nt and aa sequence can be imported from the same
		// parents.tsv without their ids colliding.
		id: "parent-sequence-" + ((alphabet == "aminoacid") ? "aa" : "nt"),
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/parentSequence",
			valueType: "String",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(75000, "default", {
				"pl7.app/table/fontFamily": "monospace",
				"pl7.app/label": (alphabet == "aminoacid") ? "Parent Sequence aa" : "Parent Sequence nt"
			})
		}
	}]
}

// Which of a parent's regions hold sub-regions, keyed [parentId] — a comma-separated
// list of region names, present only for parents that subdivide something.
parentSubdividedRegionsColumns := func(runScope) {
	return [{
		column: "subdividedRegions",
		id: "parent-subdivided-regions",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/subdividedRegions",
			valueType: "String",
			domain: runScope,
			annotations: tableAnno(74000, "default", {
				"pl7.app/label": "Subdivided regions",
				"pl7.app/description": "Regions of this parent that are split into sub-regions, comma-separated. A region listed here is not a plain region: it contains a user-defined partition, such as an insert occupying a CDR slot."
			})
		}
	}]
}

// Region membership as the composition heat map's OWN track, keyed
// [parentId, position]. Deliberately not the exported `regionAnnotation` column
// borrowed into the plot frame: that one carries no alphabet domain, so inside a
// frame holding both aa and nt positions it is not pinned to either level, and it
// is a column of the downstream export rather than of this view. Same source TSV,
// imported a second time with the plot's own identity — symmetric with
// parentResidueColumns, which is what makes both tracks resolve the same way.
heatmapRegionColumns := func(alphabet, withSubRegions) {
	cols := [{
		column: "region",
		id: "heatmap-region",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/regionAnnotation",
			valueType: "String",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(60000, "default", {
				"pl7.app/label": "Region"
			})
		}
	}]
	// Second band: the narrowest span containing each position, so a graft reads as
	// itself while the column above keeps the FR/CDR framework legible. Declared only
	// when some region is subdivided — otherwise the two carry identical values and the
	// map would stack a redundant band.
	if withSubRegions {
		cols = append(cols, {
			column: "subRegion",
			id: "heatmap-sub-region",
			allowNA: false,
			spec: {
				name: "pl7.app/repertoire/subRegionAnnotation",
				valueType: "String",
				domain: {
					"pl7.app/alphabet": alphabet
				},
				annotations: tableAnno(59000, "default", {
					"pl7.app/label": "Sub-region"
				})
			}
		})
	}
	return cols
}

// Mutation-count axis. No run scoping: the values are plain integers, identical
// in every run. The alphabet domain keeps nt and aa counts distinct.
mutationCountAxisSpec := func(alphabet, label) {
	return {
		column: "mutationCount",
		spec: {
			name: "pl7.app/repertoire/mutationCount",
			type: "Int",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: {
				"pl7.app/label": label,
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "110000"
			}
		}
	}
}

// Per-sample mutation-load counts. Summing variantCount across samples does NOT
// give unique variants — a variant seen in three samples counts three times.
mutationHistogramColumns := func(alphabet, hasUmi) {
	cols := []
	if hasUmi {
		cols = append(cols, {
			column: "moleculeCount",
			id: "bin-umi-count",
			allowNA: false,
			spec: {
				name: "pl7.app/uniqueMoleculeCount",
				valueType: "Long",
				domain: { "pl7.app/alphabet": alphabet },
				annotations: tableAnno(90500, "default", {
					"pl7.app/min": "1",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "molecules",
					"pl7.app/abundance/normalized": "false",
					"pl7.app/abundance/aggregated": "true",
					"pl7.app/label": "UMIs"
				})
			}
		})
	}
	return append(cols, {
		column: "variantCount",
		id: "variant-count",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/variantCount",
			valueType: "Long",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(100000, "default", {
				"pl7.app/min": "1",
				"pl7.app/label": "Unique Variants"
			})
		}
	}, {
		column: "readCount",
		id: "bin-read-count",
		allowNA: false,
		spec: {
			// Same name as the per-variant abundance; the alphabet domain and the
			// mutation-count axis keep it a distinct column.
			name: "pl7.app/readCount",
			valueType: "Long",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(90000, "default", {
				"pl7.app/min": "1",
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/unit": "reads",
				"pl7.app/abundance/normalized": "false",
				"pl7.app/abundance/aggregated": "true",
				"pl7.app/label": "Reads"
			})
		}
	})
}

// Known-variant axis: one distinct known (designed) sequence. Hash of the known
// sequence (nt or aa), scoped to the run. Distinct axis from `variantKey` — the
// known linker bridges the two. Carries the same `runScope` as the variant axis:
// a run has exactly one modality, so both axes always declare the same value.
knownVariantKeyAxisSpec := func(runScope, alphabet, label, ...rest) {
	col := "knownKey"
	if len(rest) > 0 {
		col = rest[0]
	}
	return {
		column: col,
		naRegex: "",
		spec: {
			name: "pl7.app/knownVariantKey",
			type: "String",
			domain: maps.merge({ "pl7.app/alphabet": alphabet }, runScope),
			annotations: {
				"pl7.app/label": label,
				"pl7.app/table/fontFamily": "monospace",
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "110000"
			}
		}
	}
}

// Known-variant table columns ([knownVariantKey]): the id as the axis LABEL
// (name pl7.app/label + single axis ⇒ the table shows it instead of the hash
// key), the known sequence, and (nt only) the linked exact-match variant's
// abundance. `withAbundance` adds readCountTotal + sampleCount.
// `naAbundance` (optional, default false): allow the abundance columns to be
// empty (NA). Used by the combined designed-nt table, where undetected designed
// entries carry no readCountTotal/sampleCount.
knownVariantColumns := func(alphabet, withAbundance, hasUmi, ...rest) {
	naAbundance := len(rest) > 0 && rest[0]
	cols := [{
		column: "label",
		id: "known-label",
		allowNA: false,
		spec: {
			name: "pl7.app/label",
			valueType: "String",
			annotations: tableAnno(100000, "default", {
				"pl7.app/label": "Known Variant Id"
			})
		}
	}, {
		column: "sequence",
		id: "known-sequence",
		allowNA: true,
		naRegex: "",
		spec: {
			name: "pl7.app/sequence",
			valueType: "String",
			domain: {
				// Matches the per-variant sequence feature (amplicon-sequence), so the
				// known/designed sequence column is the same kind of entity, just on
				// the knownVariantKey axis.
				"pl7.app/feature": "amplicon-sequence",
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(80000, "default", {
				"pl7.app/isMainSequence": "true",
				"pl7.app/isAssemblingFeature": "true",
				"pl7.app/table/fontFamily": "monospace",
				"pl7.app/label": (alphabet == "aminoacid") ? "Known Sequence aa" : "Known Sequence nt"
			})
		}
	}]
	if withAbundance {
		moleculeCountCol := {
			column: "moleculeCountTotal",
			id: "known-umi-count-total",
			allowNA: naAbundance,
			spec: {
				name: "pl7.app/uniqueMoleculeCountTotal",
				valueType: "Long",
				annotations: tableAnno(91000, "default", {
					"pl7.app/min": "1",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "molecules",
					"pl7.app/abundance/normalized": "false",
					"pl7.app/label": "Supporting UMIs"
				})
			}
		}
		readCountCol := {
			column: "readCountTotal",
			id: "known-read-count-total",
			allowNA: naAbundance,
			spec: {
				name: "pl7.app/readCountTotal",
				valueType: "Long",
				annotations: tableAnno(90000, hasUmi ? "optional" : "default", {
					"pl7.app/min": "1",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "reads",
					"pl7.app/abundance/normalized": "false",
					"pl7.app/label": "Supporting Reads"
				})
			}
		}
		sampleCountCol := {
			column: "sampleCount",
			id: "known-sample-count",
			allowNA: naAbundance,
			spec: {
				name: "pl7.app/sampleCount",
				valueType: "Int",
				annotations: tableAnno(85000, "default", {
					"pl7.app/min": "1",
					"pl7.app/label": "Number of Samples"
				})
			}
		}
		// Empty cell → NA for undetected designed entries in the combined table.
		if naAbundance {
			moleculeCountCol.naRegex = ""
			readCountCol.naRegex = ""
			sampleCountCol.naRegex = ""
		}
		if hasUmi {
			cols = append(cols, moleculeCountCol)
		}
		cols = append(cols, readCountCol, sampleCountCol)
	}
	return cols
}

// Distance (mutation count) from a variant to its nearest known entry.
knownDistanceColumns := func(isAa) {
	return [{
		column: "distance",
		id: "mutations-to-known",
		allowNA: true,
		naRegex: "",
		spec: {
			name: isAa ? "pl7.app/aaMutationsToKnown" : "pl7.app/nMutationsToKnown",
			valueType: "Int",
			domain: {
				"pl7.app/alphabet": isAa ? "aminoacid" : "nucleotide"
			},
			annotations: tableAnno(86000, "default", {
				"pl7.app/min": "0",
				"pl7.app/label": "Mutations to known"
			})
		}
	}]
}

// Cross-sample convergence summary per known-aa entry ([knownVariantKey(aa)]):
// mean of the per-sample synonymous spread (SD/CV over declared members). The
// per-sample detail stays in the exported [sampleId, knownVariantKey(aa)] columns.
convergenceSummaryColumns := func() {
	return [{
		column: "convStdDev",
		id: "conv-stddev-mean",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/aaVariantFractionStdDevMean",
			valueType: "Double",
			annotations: tableAnno(69000, "default", {
				"pl7.app/min": "0",
				"pl7.app/label": "Synonymous spread (mean SD)",
				"pl7.app/format": ".2p"
			})
		}
	}, {
		column: "convCV",
		id: "conv-cv-mean",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/aaVariantFractionCVMean",
			valueType: "Double",
			annotations: tableAnno(68000, "default", {
				"pl7.app/min": "0",
				"pl7.app/label": "Synonymous spread (mean CV)"
			})
		}
	}]
}

// Declared synonymous-member count per known-aa entry ([knownVariantKey(aa)]):
// the number of designed known-nt entries that translate to it (from knownAaToNt).
knownSynCountColumns := func() {
	return [{
		column: "declaredMemberCount",
		id: "declared-member-count",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/declaredSynonymousCount",
			valueType: "Long",
			annotations: tableAnno(60000, "default", {
				"pl7.app/min": "1",
				"pl7.app/label": "Declared synonymous members"
			})
		}
	}]
}

// Known-level per-sample abundance ([sampleId, knownVariantKey]) — read counts
// summed over the assembled variants assigned to each known variant.
knownAbundanceColumns := func(hasUmi) {
	cols := []
	if hasUmi {
		cols = append(cols, {
			column: "knownVariantMoleculeCount",
			id: "known-umi-count",
			allowNA: false,
			spec: {
				name: "pl7.app/knownVariantMoleculeCount",
				valueType: "Long",
				annotations: tableAnno(91000, "default", {
					"pl7.app/min": "0",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "molecules",
					"pl7.app/abundance/normalized": "false",
					"pl7.app/abundance/aggregated": "true",
					"pl7.app/label": "Known UMIs"
				})
			}
		}, {
			column: "knownVariantMoleculeFraction",
			id: "known-umi-fraction",
			allowNA: false,
			spec: {
				name: "pl7.app/knownVariantMoleculeFraction",
				valueType: "Double",
				annotations: tableAnno(90500, "default", {
					"pl7.app/min": "0",
					"pl7.app/max": "1",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "molecules",
					"pl7.app/abundance/normalized": "true",
					"pl7.app/abundance/aggregated": "true",
					"pl7.app/label": "Known UMI fraction",
					"pl7.app/format": ".2p"
				})
			}
		})
	}
	// Read columns demote on a UMI run, as they do for the per-variant and cross-sample
	// abundance: the molecule pair above is the primary readout.
	readVis := hasUmi ? "optional" : "default"
	return append(cols, {
		column: "knownVariantReadCount",
		id: "known-read-count",
		allowNA: false,
		spec: {
			name: "pl7.app/knownVariantReadCount",
			valueType: "Long",
			annotations: tableAnno(90000, readVis, {
				"pl7.app/min": "0",
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/unit": "reads",
				"pl7.app/abundance/normalized": "false",
				"pl7.app/abundance/aggregated": "true",
				"pl7.app/label": "Known reads"
			})
		}
	}, {
		column: "knownVariantReadFraction",
		id: "known-read-fraction",
		allowNA: false,
		spec: {
			name: "pl7.app/knownVariantReadFraction",
			valueType: "Double",
			annotations: tableAnno(89000, readVis, {
				"pl7.app/min": "0",
				"pl7.app/max": "1",
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/unit": "reads",
				"pl7.app/abundance/normalized": "true",
				"pl7.app/abundance/aggregated": "true",
				"pl7.app/label": "Known read fraction",
				"pl7.app/format": ".2p"
			})
		}
	})
}

// Synonymous-spread QC ([sampleId, variantKey(aa)]) — disagreement among an aa
// variant's nt members' per-sample fractions. High spread flags synthesis
// artifact / mis-assignment / contamination at the nt level.
convergenceColumns := func() {
	// stdDev/cv are imported from a typed Parquet (the per-sample aaConvergence
	// target), not a TSV. An empty-string naRegex would make the XSV importer emit
	// `when col == "" then null` against a Float64 column → "cannot compare string
	// with numeric (f64)". The values are never null (repertoire-pipeline fillNulls
	// stdDev to 0.0 and computes cv), so no NA handling is needed.
	return [{
		column: "stdDev",
		id: "aa-fraction-stddev",
		allowNA: false,
		spec: {
			name: "pl7.app/aaVariantFractionStdDev",
			valueType: "Double",
			annotations: tableAnno(71000, "default", {
				"pl7.app/min": "0",
				"pl7.app/label": "Synonymous spread (SD)",
				"pl7.app/format": ".2p"
			})
		}
	}, {
		column: "cv",
		id: "aa-fraction-cv",
		allowNA: false,
		spec: {
			name: "pl7.app/aaVariantFractionCV",
			valueType: "Double",
			annotations: tableAnno(70000, "default", {
				"pl7.app/min": "0",
				"pl7.app/label": "Synonymous spread (CV)"
			})
		}
	}]
}

// Linker value column (sentinel 1, isLinkerColumn). `name` distinguishes the
// linker (aaToNt / parent); the axes carry the actual relation.
linkerColumns := func(name) {
	return [{
		column: "link",
		id: "link",
		allowNA: false,
		spec: {
			name: name,
			valueType: "Int",
			annotations: {
				"pl7.app/isLinkerColumn": "true",
				"pl7.app/table/visibility": "hidden"
			}
		}
	}]
}

// Per-sample abundance columns (2 axes: sampleId, variantKey). Same shape at nt
// and aa level — the variantKey axis alphabet domain distinguishes them.
// readCount is the primary abundance + anchor (no UMI in v1) — the column
// downstream blocks (clonotype-browser etc.) discover as the dataset anchor.
// With a UMI, molecules are the primary abundance and reads become secondary and
// default-hidden; without a UMI, reads are primary.
perSampleAbundanceColumns := func(hasUmi) {
	cols := []
	if hasUmi {
		cols = append(cols, {
			column: "uniqueMoleculeCount",
			id: "umi-count",
			allowNA: false,
			spec: {
				name: "pl7.app/uniqueMoleculeCount",
				valueType: "Long",
				annotations: tableAnno(91000, "default", {
					"pl7.app/min": "1",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "molecules",
					"pl7.app/abundance/normalized": "false",
					"pl7.app/abundance/isPrimary": "true",
					"pl7.app/isAnchor": "true",
					"pl7.app/label": "Number of UMIs"
				})
			}
		}, {
			column: "uniqueMoleculeFraction",
			id: "umi-fraction",
			allowNA: false,
			spec: {
				name: "pl7.app/uniqueMoleculeFraction",
				valueType: "Double",
				annotations: tableAnno(90500, "default", {
					"pl7.app/min": "0",
					"pl7.app/max": "1",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "molecules",
					"pl7.app/abundance/normalized": "true",
					"pl7.app/abundance/isPrimary": "true",
					"pl7.app/label": "Fraction of UMIs",
					"pl7.app/format": ".2p"
				})
			}
		})
	}
	readAnno := {
		"pl7.app/min": "1",
		"pl7.app/isAbundance": "true",
		"pl7.app/abundance/unit": "reads",
		"pl7.app/abundance/normalized": "false",
		"pl7.app/label": "Number of Reads"
	}
	readFracAnno := {
		"pl7.app/min": "0",
		"pl7.app/max": "1",
		"pl7.app/isAbundance": "true",
		"pl7.app/abundance/unit": "reads",
		"pl7.app/abundance/normalized": "true",
		"pl7.app/label": "Fraction of reads",
		"pl7.app/format": ".2p"
	}
	if !hasUmi {
		readAnno["pl7.app/abundance/isPrimary"] = "true"
		readAnno["pl7.app/isAnchor"] = "true"
		readFracAnno["pl7.app/abundance/isPrimary"] = "true"
	}
	return append(cols, {
		column: "readCount",
		id: "read-count",
		allowNA: false,
		spec: {
			name: "pl7.app/readCount",
			valueType: "Long",
			annotations: tableAnno(90000, hasUmi ? "optional" : "default", readAnno)
		}
	}, {
		column: "readFraction",
		id: "read-fraction",
		allowNA: false,
		spec: {
			name: "pl7.app/readFraction",
			valueType: "Double",
			annotations: tableAnno(89000, hasUmi ? "optional" : "default", readFracAnno)
		}
	})
}

// Per-variant region subsequence columns (one per region feature), keyed by
// variantKey. The TSV column is nSeq<name>/aaSeq<name> (matching mitool); each
// carries the region as its `pl7.app/feature` domain so downstream blocks find
// it by {feature, alphabet}.
// The canonical FR/CDR feature a prefixed region name carries, else undefined. An
// auto-detect domain names its columns `<domain>_FR1`…, so `VH_CDR3` carries feature
// `CDR3`. This lets a chain-tagged region present the same feature VALUE as
// mixcr-scfv-clonotyping (under `pl7.app/feature`), with the chain held separately in
// `pl7.app/vdj/chain`.
CANONICAL_FR_CDR := ["FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"]
canonicalFeature := func(regionName) {
	canonical := {FR1: true, CDR1: true, FR2: true, CDR2: true, FR3: true, CDR3: true, FR4: true}
	// A bare canonical name (a manual vdj region, e.g. `FR1`) is canonical as-is. A prefixed
	// name (auto-detect, e.g. `VH_FR1`) is canonical by its suffix after the last underscore.
	if !is_undefined(canonical[regionName]) {
		return regionName
	}
	idx := -1
	for i := 0; i < len(regionName); i++ {
		if regionName[i] == '_' {
			idx = i
		}
	}
	if idx < 0 {
		return undefined
	}
	suffix := regionName[idx+1:]
	return !is_undefined(canonical[suffix]) ? suffix : undefined
}

// Per-region sequence columns. Every region stays in the amplicon namespace
// (`pl7.app/sequence` keyed by `pl7.app/feature`), which is what the profiler's downstream
// consumers read. Two cases, by whether the region carries a chain:
//   - untagged (a general amplicon / designed-library region): feature = the region name.
//   - chain-tagged (an scFv construct): feature = the canonical value (`CDR3`, `FR1`, …, or
//     `VDJRegion` for the whole V-domain), the same values mixcr-scfv-clonotyping uses. Both chains
//     carry the same feature and are told apart by `pl7.app/vdj/chain` (Heavy / Light) plus the
//     recombination annotation, the role the reference's scClonotypeChain plays. The column name
//     stays `pl7.app/sequence`; the label shows "Heavy CDR3", "Light VDJRegion".
regionSeqColumns := func(alphabet, regionNames, regionChains) {
	prefix := (alphabet == "aminoacid") ? "aaSeq" : "nSeq"
	suffix := (alphabet == "aminoacid") ? " aa" : " nt"
	cols := []
	// An auto-detect V-domain container (VH / VL) carries feature `VDJRegion`; it is recognised
	// by its canonical children (`<name>_FR1`…) sitting in the same list. A custom chain-tagged
	// region is none of these and keeps its own name as the feature.
	nameSet := {}
	for i := 0; i < len(regionNames); i++ {
		nameSet[regionNames[i]] = true
	}
	isWholeDomain := func(rn) {
		for c in CANONICAL_FR_CDR {
			if !is_undefined(nameSet[rn + "_" + c]) {
				return true
			}
		}
		return false
	}
	for i := 0; i < len(regionNames); i++ {
		rn := regionNames[i]
		cid := is_undefined(regionChains) ? undefined : regionChains[rn]
		anno := { "pl7.app/table/fontFamily": "monospace" }
		if is_undefined(cid) {
			// General amplicon region: distinct feature values keep the specs distinct, so a
			// sequence-consuming downstream block that discovers these feature-agnostically
			// (clonotype-clustering) still resolves the picked column uniquely.
			anno["pl7.app/label"] = rn + suffix
			cols = append(cols, {
				column: prefix + rn,
				id: "region-" + rn,
				allowNA: true,
				naRegex: "",
				spec: {
					name: "pl7.app/sequence",
					valueType: "String",
					domain: { "pl7.app/feature": rn, "pl7.app/alphabet": alphabet },
					annotations: tableAnno(75000 - i * 100, "optional", anno)
				}
			})
		} else {
			bi := chainIdInfo(cid)
			recomb := recombinationOf(bi.chain)
			// A chain-tagged scFv region. The feature is the canonical value (`CDR3`, `FR1`, …, or
			// `VDJRegion` for the whole V-domain) — the same values mixcr-scfv-clonotyping uses. Both
			// chains carry the same feature and are told apart by `pl7.app/vdj/chain` (Heavy / Light),
			// which the consumers read. The column stays in the amplicon namespace (`pl7.app/sequence`)
			// and the label shows "Heavy CDR3", "Light VDJRegion". The TSV column id keeps the domain
			// prefix (`nSeqVH_CDR3`) so the two chains' columns stay distinct in the export.
			cf := canonicalFeature(rn)
			feature := !is_undefined(cf) ? cf : (isWholeDomain(rn) ? "VDJRegion" : rn)
			anno["pl7.app/label"] = bi.chain + " " + feature + suffix
			anno["pl7.app/vdj/chain/recombination"] = recomb
			cols = append(cols, {
				column: prefix + rn,
				id: "region-" + rn,
				allowNA: true,
				naRegex: "",
				spec: {
					name: "pl7.app/sequence",
					valueType: "String",
					domain: {
						"pl7.app/feature": feature,
						"pl7.app/alphabet": alphabet,
						"pl7.app/vdj/chain": bi.chain
					},
					annotations: tableAnno(75000 - i * 100, "optional", anno)
				}
			})
		}
	}
	return cols
}

// Per-position region membership ([parentId, position] -> region name). Colours
// the aa state-matrix heat map; positions are the aa axis (1-based).
regionAnnotationColumns := func(withSubRegions) {
	cols := [{
		column: "region",
		id: "region",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/regionAnnotation",
			valueType: "String",
			annotations: tableAnno(70000, "default", {
				"pl7.app/label": "Region"
			})
		}
	}]
	// See heatmapRegionColumns: the narrow reading, exported for downstream heat maps,
	// and only when some region is subdivided.
	if withSubRegions {
		cols = append(cols, {
			column: "subRegion",
			id: "sub-region",
			allowNA: false,
			spec: {
				name: "pl7.app/repertoire/subRegionAnnotation",
				valueType: "String",
				annotations: tableAnno(69000, "default", {
					"pl7.app/label": "Sub-region"
				})
			}
		})
	}
	return cols
}

// Per-variant columns aggregated cross-sample (1 axis: variantKey). `isAa` adds
// the synonymous-replicate count (ntVariantCount), which exists only at aa level.
// `regionNames` adds per-region sequence columns; `completeFeatureName` (when set)
// relabels the whole-variant sequence feature (e.g. VDJRegion). `regionChains` maps
// a region name to its chain id, tagging that region's column with vdj/chain (scFv).
// `chainIds` is the run's distinct chain-id set; a two-chain IG construct is an scFv,
// which names the whole-variant sequence when no single complete feature does.
aggregatedColumns := func(alphabet, isAa, regionNames, completeFeatureName, hasUmi, regionChains, chainIds) {
	seqSuffix := (alphabet == "aminoacid") ? " aa" : " nt"
	// The whole-variant sequence label: a per-parent complete feature (VDJRegion for a single
	// V-domain) wins; else a two-chain IG construct is an scFv; else the generic "Sequence".
	// The scFv name is derived here, not written as a mitool complete feature — that would add
	// a redundant whole-parent column spanning both chains.
	seqBase := "Sequence"
	if !is_undefined(completeFeatureName) && completeFeatureName != "" {
		seqBase = completeFeatureName
	} else {
		info := distinctChainInfo(is_undefined(chainIds) ? [] : chainIds)
		if len(info) == 2 && info[0].receptor == "IG" {
			// Match mixcr-scfv-clonotyping's label for the whole construct ("scFv sequence aa").
			seqBase = "scFv sequence"
		}
	}
	seqLabel := seqBase + seqSuffix
	cols := [{
		column: "variantLabel",
		id: "variant-label",
		spec: {
			name: "pl7.app/label",
			valueType: "String",
			annotations: tableAnno(100000, "default", {
				"pl7.app/label": "Variant Id"
			})
		}
	}, {
		column: "sequence",
		id: "sequence",
		spec: {
			name: "pl7.app/sequence",
			valueType: "String",
			domain: {
				// Stable feature descriptor for the whole-variant sequence: always
				// "amplicon-sequence". Sequence-consuming downstream blocks (e.g.
				// clonotype-clustering) discover these on the variantKey axis by
				// {feature, alphabet} — a fixed feature value keeps that match working
				// regardless of the run's region scheme. The parent's complete-feature
				// name (e.g. VDJRegion), when set, is carried in the label + flagged via
				// pl7.app/isAssemblingFeature, NOT folded into the matchable feature key.
				"pl7.app/feature": "amplicon-sequence",
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(80000, "default", {
				"pl7.app/isMainSequence": "true",
				"pl7.app/isAssemblingFeature": "true",
				"pl7.app/table/fontFamily": "monospace",
				"pl7.app/label": seqLabel
			})
		}
	}, {
		column: "mutations",
		id: "mutations",
		allowNA: true,
		naRegex: "",
		spec: {
			name: "pl7.app/repertoire/mutations",
			valueType: "String",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(95000, "default", {
				"pl7.app/table/fontFamily": "monospace",
				"pl7.app/label": "Mutations",
				"pl7.app/description": "Changes from the parent, 1-based, colon-separated. Examples: SA42G - A at position 42 changed to G. DT17 - T at position 17 deleted. I5C - C inserted before position 5"
			})
		}
	}, {
		column: "mutationCount",
		id: "mutation-count",
		allowNA: false,
		spec: {
			name: "pl7.app/repertoire/mutationCount",
			valueType: "Int",
			domain: {
				"pl7.app/alphabet": alphabet
			},
			annotations: tableAnno(94000, "default", {
				"pl7.app/min": "0",
				"pl7.app/label": (alphabet == "aminoacid") ? "AA mutations" : "Nt mutations"
			})
		}
	}, {
		// Same name, values and filter annotations as the MiXCR blocks' column. All
		// "true" when the run drops non-productive variants.
		column: "isProductive",
		id: "is-productive",
		allowNA: false,
		spec: {
			name: "pl7.app/vdj/sequence/productive",
			valueType: "String",
			annotations: tableAnno(93000, "optional", {
				"pl7.app/label": "Productive",
				"pl7.app/description": "No frame shift and no stop codon in the translation.",
				"pl7.app/isDiscreteFilter": "true",
				"pl7.app/discreteValues": string(json.encode(["true", "false"]))
			})
		}
	}, {
		column: "readCountTotal",
		id: "read-count-total",
		allowNA: false,
		spec: {
			name: "pl7.app/readCountTotal",
			valueType: "Long",
			annotations: tableAnno(90000, hasUmi ? "optional" : "default", {
				"pl7.app/min": "1",
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/unit": "reads",
				"pl7.app/abundance/normalized": "false",
				"pl7.app/label": "Supporting Reads"
			})
		}
	}, {
		column: "readFractionMean",
		id: "read-fraction-mean",
		allowNA: false,
		spec: {
			name: "pl7.app/readFractionMean",
			valueType: "Double",
			annotations: tableAnno(88000, hasUmi ? "optional" : "default", {
				"pl7.app/min": "0",
				"pl7.app/max": "1",
				"pl7.app/label": "Mean Fraction of Reads",
				"pl7.app/format": ".2p"
			})
		}
	}, {
		column: "sampleCount",
		id: "sample-count",
		allowNA: false,
		spec: {
			name: "pl7.app/sampleCount",
			valueType: "Int",
			annotations: tableAnno(85000, "default", {
				"pl7.app/min": "1",
				"pl7.app/label": "Number of Samples"
			})
		}
	}]
	if hasUmi {
		cols = append(cols, {
			column: "uniqueMoleculeCountSum",
			id: "umi-count-total",
			allowNA: false,
			spec: {
				name: "pl7.app/uniqueMoleculeCountTotal",
				valueType: "Long",
				annotations: tableAnno(91000, "default", {
					"pl7.app/min": "1",
					"pl7.app/isAbundance": "true",
					"pl7.app/abundance/unit": "molecules",
					"pl7.app/abundance/normalized": "false",
					"pl7.app/label": "Supporting UMIs"
				})
			}
		}, {
			column: "uniqueMoleculeFractionMean",
			id: "umi-fraction-mean",
			allowNA: false,
			spec: {
				name: "pl7.app/uniqueMoleculeFractionMean",
				valueType: "Double",
				annotations: tableAnno(89500, "default", {
					"pl7.app/min": "0",
					"pl7.app/max": "1",
					"pl7.app/label": "Mean Fraction of UMIs",
					"pl7.app/format": ".2p"
				})
			}
		})
	}
	if isAa {
		cols = append(cols, {
			column: "ntVariantCount",
			id: "nt-variant-count",
			allowNA: false,
			spec: {
				name: "pl7.app/ntVariantCount",
				valueType: "Int",
				annotations: tableAnno(84000, "default", {
					"pl7.app/min": "1",
					"pl7.app/label": "Synonymous NT variants"
				})
			}
		})
	}
	for c in regionSeqColumns(alphabet, regionNames, regionChains) {
		cols = append(cols, c)
	}
	return cols
}

// Per-sample QC metrics table (1 axis: sampleId). Mirrors the scalar fields of
// mitool's RepertoireQc.Report (qc.json): variant counts, total reads,
// frame-shift, and the assignment buckets (populated only when a known set is
// supplied — otherwise 0). The synonymous-replicate histogram is a distribution,
// not a per-sample scalar, so it is left for a future chart.
qcColumns := func(sampleIdAxisSpec, hasUmi) {
	longCol := func(col, id, order, vis, label, desc) {
		return {
			column: col,
			id: id,
			allowNA: true,
			naRegex: "NaN",
			spec: {
				name: "pl7.app/repertoire/qc/" + col,
				valueType: "Long",
				annotations: tableAnno(order, vis, {
					"pl7.app/min": "0",
					"pl7.app/label": label,
					"pl7.app/description": desc
				})
			}
		}
	}
	fracCol := func(col, id, order, vis, label, desc) {
		return {
			column: col,
			id: id,
			allowNA: true,
			naRegex: "NaN",
			spec: {
				name: "pl7.app/repertoire/qc/" + col,
				valueType: "Double",
				annotations: tableAnno(order, vis, {
					"pl7.app/min": "0",
					"pl7.app/max": "1",
					"pl7.app/format": ".2p",
					"pl7.app/label": label,
					"pl7.app/description": desc
				})
			}
		}
	}
	// A UMI run leads with molecules; read-based columns demote to `optional`.
	readVis := hasUmi ? "optional" : "default"
	cols := [
			longCol("ntVariants", "nt-variants", 100000, "default", "NT Variants", "Distinct nucleotide variants assembled."),
			longCol("aaVariants", "aa-variants", 99000, "default", "AA Variants", "Distinct amino-acid variants."),
			longCol("totalReads", "total-reads", 98000, readVis, "Total Reads", "Reads assigned to variants."),
			longCol("frameShiftVariants", "frame-shift-variants", 90000, "default", "Frame-Shift Variants", "Variants whose mutations shift the reading frame."),
			longCol("frameShiftReads", "frame-shift-reads", 89000, "optional", "Frame-Shift Reads", "Reads on frame-shift variants."),
			fracCol("frameShiftReadFraction", "frame-shift-read-fraction", 88000, readVis, "Frame-Shift Reads (%)", "Fraction of total reads on frame-shift variants."),
			longCol("stopCodonVariants", "stop-codon-variants", 87900, "default", "Stop-Codon Variants", "In-frame variants whose translation carries a stop codon."),
			longCol("stopCodonReads", "stop-codon-reads", 87700, "optional", "Stop-Codon Reads", "Reads on stop-codon variants."),
			fracCol("stopCodonReadFraction", "stop-codon-read-fraction", 87500, readVis, "Stop-Codon Reads (%)", "Fraction of total reads on stop-codon variants."),
			longCol("aaMutationsExceededVariants", "aa-mutations-exceeded-variants", 87000, "default", "AA Mutation-Limit Variants", "In-frame variants dropped by mutation filter"),
			longCol("aaMutationsExceededReads", "aa-mutations-exceeded-reads", 86000, "optional", "AA Mutation-Limit Reads", "Reads on aa mutation-limit variants."),
			fracCol("aaMutationsExceededReadFraction", "aa-mutations-exceeded-read-fraction", 85000, readVis, "AA Mutation-Limit Reads (%)", "Fraction of total reads on aa mutation-limit variants."),
			longCol("ntIndelReads", "nt-indel-reads", 84000, "default", "NT Indel Reads", "Reads rejected at alignment for carrying an insertion or deletion (substitutions-only filter)."),
			fracCol("ntIndelReadFraction", "nt-indel-read-fraction", 83000, readVis, "NT Indel Reads (%)", "Fraction of processed reads rejected for carrying an indel."),
			longCol("lowCoverageVariants", "low-coverage-variants", 82000, "default", "Low-Coverage Variants", "Variants discarded by the Min variant reads gate, before mutation calling. Zero when the gate is off."),
			longCol("lowCoverageReads", "low-coverage-reads", 81500, "optional", "Low-Coverage Reads", "Reads carried by the variants the Min variant reads gate discarded. These are counted nowhere else in this table."),
			fracCol("lowCoverageReadFraction", "low-coverage-read-fraction", 81000, readVis, "Low-Coverage Reads (%)", "Fraction of the reads entering assembly that the Min variant reads gate discarded."),
			longCol("assignedVariants", "assigned-variants", 80000, "optional", "Assigned Variants", "Variants matched to a known-set entry (assignment run only)."),
			longCol("assignedReads", "assigned-reads", 79000, "optional", "Assigned Reads", "Reads on assigned variants."),
			fracCol("assignedReadFraction", "assigned-read-fraction", 78000, "optional", "Assigned Reads (%)", "Fraction of total reads on assigned variants."),
			longCol("unassignedVariants", "unassigned-variants", 77000, "optional", "Unassigned Variants", "Novel variants with no known-set match."),
			longCol("unassignedReads", "unassigned-reads", 76000, "optional", "Unassigned Reads", "Reads on unassigned (novel) variants."),
			fracCol("unassignedReadFraction", "unassigned-read-fraction", 75000, "optional", "Unassigned Reads (%)", "Fraction of total reads on unassigned variants."),
			longCol("ambiguousVariants", "ambiguous-variants", 74000, "optional", "Ambiguous Variants", "Variants matching more than one known-set entry."),
			longCol("ambiguousReads", "ambiguous-reads", 73000, "optional", "Ambiguous Reads", "Reads on ambiguous variants."),
			fracCol("ambiguousReadFraction", "ambiguous-read-fraction", 72000, "optional", "Ambiguous Reads (%)", "Fraction of total reads on ambiguous variants.")
	]
	if hasUmi {
		cols = append(cols,
			longCol("totalMolecules", "total-molecules", 98500, "default", "Total UMIs", "Distinct molecules (UMIs) behind the variants."),
			// Reads over molecules: a ratio, so no 0-1 range and no percent format.
			{
				column: "readsPerMolecule",
				id: "reads-per-molecule",
				allowNA: true,
				naRegex: "NaN",
				spec: {
					name: "pl7.app/repertoire/qc/readsPerMolecule",
					valueType: "Double",
					annotations: tableAnno(98400, "default", {
						"pl7.app/min": "0",
						"pl7.app/format": ".2f",
						"pl7.app/label": "Reads per UMI",
						"pl7.app/description": "Sequencing depth per molecule: total reads divided by distinct UMIs."
					})
				}
			},
			longCol("frameShiftMolecules", "frame-shift-molecules", 89500, "optional", "Frame-Shift UMIs", "UMIs on frame-shift variants."),
			fracCol("frameShiftMoleculeFraction", "frame-shift-molecule-fraction", 88500, "default", "Frame-Shift UMIs (%)", "Fraction of total UMIs on frame-shift variants."),
			longCol("stopCodonMolecules", "stop-codon-molecules", 87800, "optional", "Stop-Codon UMIs", "UMIs on stop-codon variants."),
			fracCol("stopCodonMoleculeFraction", "stop-codon-molecule-fraction", 87600, "default", "Stop-Codon UMIs (%)", "Fraction of total UMIs on stop-codon variants."),
			longCol("aaMutationsExceededMolecules", "aa-mutations-exceeded-molecules", 86500, "optional", "AA Mutation-Limit UMIs", "UMIs on aa mutation-limit variants."),
			fracCol("aaMutationsExceededMoleculeFraction", "aa-mutations-exceeded-molecule-fraction", 85500, "default", "AA Mutation-Limit UMIs (%)", "Fraction of total UMIs on aa mutation-limit variants."),
			longCol("assignedMolecules", "assigned-molecules", 79500, "optional", "Assigned UMIs", "UMIs on assigned variants."),
			fracCol("assignedMoleculeFraction", "assigned-molecule-fraction", 78500, "optional", "Assigned UMIs (%)", "Fraction of total UMIs on assigned variants."),
			longCol("unassignedMolecules", "unassigned-molecules", 76500, "optional", "Unassigned UMIs", "UMIs on unassigned (novel) variants."),
			fracCol("unassignedMoleculeFraction", "unassigned-molecule-fraction", 75500, "optional", "Unassigned UMIs (%)", "Fraction of total UMIs on unassigned variants."),
			longCol("ambiguousMolecules", "ambiguous-molecules", 73500, "optional", "Ambiguous UMIs", "UMIs on ambiguous variants."),
			fracCol("ambiguousMoleculeFraction", "ambiguous-molecule-fraction", 72500, "optional", "Ambiguous UMIs (%)", "Fraction of total UMIs on ambiguous variants.")
		)
	}
	return {
		axes: [{ column: "sampleId", spec: sampleIdAxisSpec }],
		columns: cols,
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

export {
	runScopeDomain: runScopeDomain,
	variantScopeDomain: variantScopeDomain,
	regionSeqColumns: regionSeqColumns,
	variantKeyAxisSpec: variantKeyAxisSpec,
	parentIdAxisSpec: parentIdAxisSpec,
	positionAxisSpec: positionAxisSpec,
	mutationCountAxisSpec: mutationCountAxisSpec,
	mutationHistogramColumns: mutationHistogramColumns,
	stateMatrixColumns: stateMatrixColumns,
	stateAxisSpec: stateAxisSpec,
	stateHeatmapColumns: stateHeatmapColumns,
	parentResidueColumns: parentResidueColumns,
	parentSequenceColumns: parentSequenceColumns,
	parentSubdividedRegionsColumns: parentSubdividedRegionsColumns,
	heatmapRegionColumns: heatmapRegionColumns,
	knownVariantKeyAxisSpec: knownVariantKeyAxisSpec,
	knownVariantColumns: knownVariantColumns,
	knownDistanceColumns: knownDistanceColumns,
	knownSynCountColumns: knownSynCountColumns,
	convergenceSummaryColumns: convergenceSummaryColumns,
	knownAbundanceColumns: knownAbundanceColumns,
	convergenceColumns: convergenceColumns,
	linkerColumns: linkerColumns,
	perSampleAbundanceColumns: perSampleAbundanceColumns,
	aggregatedColumns: aggregatedColumns,
	regionAnnotationColumns: regionAnnotationColumns,
	qcColumns: qcColumns
}
