// Bucket plan for the cross-sample variant aggregate and the owner jobs of the state-matrix dedup.
//
// Rows split into K key buckets by the first 2 chars of the variant key (16 lowercase hex
// chars): prefix value p (0..255) goes to bucket p % K. A key that is null, empty or not hex
// goes to bucket 0. A key maps to one bucket, so each group is complete inside its bucket.
// The even split relies on mitool's lowercase-hex keys: keys in another format all land in
// bucket 0, whose job requests a 1/K share.
//
// Labels split into L label buckets by the first letter of the label prefix. The 26 letters
// are dealt round-robin; a prefix not starting with A-Z, including an empty one, goes to label
// bucket 0.
//
// Known keys (the known-set aggregate) are 20 chars of base64 without `+` and `/`, so they split
// on their own alphabet of 62 symbols: K1 = min(K, 32) groups of first chars times K / K1 groups
// of second chars, each dealt round-robin. A bucket's share of the keys is at most
// ceil(62 / K1) x ceil(62 / K2) / 62^2, which the job is sized for. A key that is null or does
// not start with two such chars goes to bucket 0.
//
// K is the smallest power of two with totalBytes / K <= TARGET_BUCKET_BYTES, at most
// MAX_KEY_BUCKETS. Without blob sizes, totalBytes is samples x EST_SAMPLE_BYTES for the variant
// aggregate and samples x EST_PAIR_SAMPLE_BYTES for the dedup owner jobs. L = min(K, 26).
//
// Bucket job need: 2 GiB + 1 MiB x samples + 6 x totalBytes / K. Every bucket scans all
// samples, so the per-sample term does not shrink with K. Smallest passing hard limit of the aa
// bucket job at 400 / 800 / 1,600 / 4,000 samples: 3.25 / 2.75 / 2.75 / 4.5 GiB. A dedup owner job
// passes at 1.5 GiB at 400 samples with K=16 (law: 3.3 GiB), 4 GiB at 400 with K=4 (6.0), and
// 4 GiB at 10 samples of 4M variants with K=1 (5.1). Request: max(floor, 2 x need,
// aggMemGB GiB); the caller passes aggMemGB only on a backend without blob sizes.

ll := import("@platforma-sdk/workflow-tengo:ll")
units := import("@platforma-sdk/workflow-tengo:units")
math := import("math")
aggSizing := import(":aggregate-sizing")
variantLabel := import(":variant-label")

TARGET_BUCKET_BYTES := 1 * units.GiB
EST_SAMPLE_BYTES := 42 * units.MiB
// Abundance and keys parquets of one sample, the input of a dedup owner job.
EST_PAIR_SAMPLE_BYTES := 6 * units.MiB
PREFIX_COUNT := 256
MAX_KEY_BUCKETS := 256
LABEL_LETTERS := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

NEED_BASE_BYTES := 2 * units.GiB
NEED_PER_SAMPLE_BYTES := 1 * units.MiB
NEED_PER_INPUT_BYTE := 6

HEX := "0123456789abcdef"
B62 := "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
MAX_FIRST_GROUPS := 32

ALL_LETTERS := []
for i := 0; i < len(LABEL_LETTERS); i++ {
	ALL_LETTERS = append(ALL_LETTERS, LABEL_LETTERS[i:i + 1])
}

// hexPrefix returns p (0..255) as 2 lowercase hex chars.
hexPrefix := func(p) {
	return HEX[p / 16:p / 16 + 1] + HEX[p % 16:p % 16 + 1]
}

ALL_PREFIXES := []
for p := 0; p < PREFIX_COUNT; p++ {
	ALL_PREFIXES = append(ALL_PREFIXES, hexPrefix(p))
}

// isPowerOfTwoUpTo returns true for 1, 2, 4, ... max.
isPowerOfTwoUpTo := func(n, max) {
	for v := 1; v <= max; v *= 2 {
		if n == v {
			return true
		}
	}
	return false
}

// plan chooses the key bucket count k and the label bucket count l.
//
// @param totalBytes: int | undefined - bytes over all inputs; undefined without blob sizes
// @param samples: int - sample count
// @param override: int | undefined - sets k directly; a power of two from 1 to 256
// @param estSampleBytes: int - optional; bytes per sample assumed without blob sizes
// @return { k: int, l: int, totalBytes: int }
plan := func(totalBytes, samples, override, ...estSampleBytes) {
	ll.assert(len(estSampleBytes) <= 1, "too many arguments")
	if is_undefined(totalBytes) {
		totalBytes = samples * (len(estSampleBytes) == 1 ? estSampleBytes[0] : EST_SAMPLE_BYTES)
	}

	k := 1
	if !is_undefined(override) {
		k = int(override)
		ll.assert(float(k) == float(override) && isPowerOfTwoUpTo(k, MAX_KEY_BUCKETS),
			"aggBuckets must be a power of two from 1 to %d, got %v", MAX_KEY_BUCKETS, override)
	} else {
		for k < MAX_KEY_BUCKETS && k * TARGET_BUCKET_BYTES < totalBytes {
			k *= 2
		}
	}

	return { k: k, l: int(math.min(k, len(LABEL_LETTERS))), totalBytes: totalBytes }
}

// keyBucketPrefixes returns k lists of 2-char key prefixes; prefix value p is in list p % k.
keyBucketPrefixes := func(k) {
	lists := []
	for i := 0; i < k; i++ {
		lists = append(lists, [])
	}
	for p := 0; p < PREFIX_COUNT; p++ {
		lists[p % k] = append(lists[p % k], ALL_PREFIXES[p])
	}
	return lists
}

// keyPredicate returns the filter selecting rows of column `col` whose key prefix is one of
// `prefixes`. With catchAll it also selects null, empty and non-hex keys.
keyPredicate := func(pt, col, prefixes, catchAll) {
	prefix := pt.col(col).fillNull("").strSlice(0, 2)
	pred := prefix.inSet(prefixes...)
	if catchAll {
		pred = pred.or(prefix.inSet(ALL_PREFIXES...).not())
	}
	return pred
}

// labelLetters deals the 26 letters round-robin into l strings.
labelLetters := func(l) {
	letters := []
	for i := 0; i < l; i++ {
		letters = append(letters, "")
	}
	for i := 0; i < len(LABEL_LETTERS); i++ {
		letters[i % l] += LABEL_LETTERS[i:i + 1]
	}
	return letters
}

// labelPredicate returns the filter selecting rows whose label prefix starts with one of
// `letters` (a string of letters). With catchAll it also selects a prefix whose first char is
// outside A-Z, including an empty or null prefix.
labelPredicate := func(pt, hashCol, letters, catchAll) {
	first := variantLabel.labelPrefixExpr(pt, hashCol).strSlice(0, 1).fillNull("")
	set := []
	for i := 0; i < len(letters); i++ {
		set = append(set, letters[i:i + 1])
	}
	pred := first.inSet(set...)
	if catchAll {
		pred = pred.or(first.inSet(ALL_LETTERS...).not())
	}
	return pred
}

// dealChars deals the chars of `alphabet` round-robin into n lists.
dealChars := func(alphabet, n) {
	lists := []
	for i := 0; i < n; i++ {
		lists = append(lists, [])
	}
	for i := 0; i < len(alphabet); i++ {
		lists[i % n] = append(lists[i % n], alphabet[i:i + 1])
	}
	return lists
}

ALL_B62 := dealChars(B62, 1)[0]

// knownKeyGroups returns the first-char and second-char group counts of k known-key buckets.
knownKeyGroups := func(k) {
	k1 := k < MAX_FIRST_GROUPS ? k : MAX_FIRST_GROUPS
	return { k1: k1, k2: k / k1 }
}

// knownKeyBuckets returns k buckets { first: [char], second: [char] | undefined }; a key is in
// the bucket whose lists hold its first and second char. `second` is undefined when the split
// uses the first char only.
knownKeyBuckets := func(k) {
	g := knownKeyGroups(k)
	firsts := dealChars(B62, g.k1)
	seconds := dealChars(B62, g.k2)
	res := []
	for i2 := 0; i2 < g.k2; i2++ {
		for i1 := 0; i1 < g.k1; i1++ {
			res = append(res, { first: firsts[i1], second: g.k2 > 1 ? seconds[i2] : undefined })
		}
	}
	return res
}

// knownKeyPredicate returns the filter selecting rows of column `col` whose known key is in
// `bucket`. With catchAll it also selects keys outside the alphabet, null and empty ones.
knownKeyPredicate := func(pt, col, bucket, catchAll) {
	first := pt.col(col).fillNull("").strSlice(0, 1)
	pred := first.inSet(bucket.first...)
	valid := first.inSet(ALL_B62...)
	if !is_undefined(bucket.second) {
		second := pt.col(col).fillNull("").strSlice(1, 1)
		pred = pred.and(second.inSet(bucket.second...))
		valid = valid.and(second.inSet(ALL_B62...))
	}
	if catchAll {
		pred = pred.or(valid.not())
	}
	return pred
}

// knownKeyShare returns the largest share of the keys one of k known-key buckets holds, as
// { num, den }.
knownKeyShare := func(k) {
	g := knownKeyGroups(k)
	n := len(B62)
	return { num: ((n + g.k1 - 1) / g.k1) * ((n + g.k2 - 1) / g.k2), den: n * n }
}

// bucketName returns bucket index b as 3 digits, so names sort in bucket order.
bucketName := func(b) {
	s := string(b)
	for len(s) < 3 {
		s = "0" + s
	}
	return s
}

// flatJobBytes returns max(floor, aggMemGB GiB) in bytes; aggMemGB may be undefined or a float.
flatJobBytes := func(aggMemGB) {
	return aggSizing.requestBytes(0, aggMemGB)
}

// bucketJobBytes returns the request of one key bucket job, in bytes.
bucketJobBytes := func(samples, totalBytes, k, aggMemGB) {
	inputTerm := (NEED_PER_INPUT_BYTE * totalBytes + k - 1) / k
	need := NEED_BASE_BYTES + NEED_PER_SAMPLE_BYTES * samples + inputTerm
	return aggSizing.requestBytes(need, aggMemGB)
}

// shareJobBytes returns the request of a bucket job that holds num / den of totalBytes, in bytes.
shareJobBytes := func(samples, totalBytes, num, den, aggMemGB) {
	inputTerm := (NEED_PER_INPUT_BYTE * totalBytes * num + den - 1) / den
	need := NEED_BASE_BYTES + NEED_PER_SAMPLE_BYTES * samples + inputTerm
	return aggSizing.requestBytes(need, aggMemGB)
}

export {
	EST_PAIR_SAMPLE_BYTES: EST_PAIR_SAMPLE_BYTES,

	plan: plan,
	keyBucketPrefixes: keyBucketPrefixes,
	keyPredicate: keyPredicate,
	bucketName: bucketName,
	labelLetters: labelLetters,
	labelPredicate: labelPredicate,
	bucketJobBytes: bucketJobBytes,
	knownKeyBuckets: knownKeyBuckets,
	knownKeyPredicate: knownKeyPredicate,
	knownKeyShare: knownKeyShare,
	shareJobBytes: shareJobBytes,
	flatJobBytes: flatJobBytes
}
