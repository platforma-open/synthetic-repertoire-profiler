// Memory of the cross-sample ptabler steps: the variant and known-set aggregates, the
// state-matrix dedup, the composition heat map, and the variant-keyed imports.
//
// On a backend that reports blob sizes, each step keeps pt's input-size rule, 4 GiB + slope x
// input, with no upper limit, and a floor of FLOOR_GIB. The slope is pt's 10 unless a step sets
// its own below. The "Memory for aggregation" setting does not apply there: the grant already
// covers the measured need, so a user number could only shrink how many steps the queue admits
// at once.
//
// A backend without blob sizes cannot evaluate the rule. There each step gets a flat
// FLOOR_GIB, and the setting raises it. Same rule as mixcr-clonotyping's shard plan.
//
// aggregate-variants follows neither rule; see its row below.
//
// Measured peak RSS per stored input byte, polars 1.33.1, 8 threads, 1 to 6 samples:
//
//   aggregate-variants        no slope, no input-size rule, on both backends: each job requests
//                             a fixed amount (applyComputed) from aggregate-buckets.lib.tengo:
//                             a key-bucket job 2 x the bucket law on samples and input bytes
//                             per bucket, a label or concat job FLOOR_GIB, each at least
//                             FLOOR_GIB; without blob sizes the input bytes are estimated from
//                             the sample count and the setting raises each request
//   state-matrix dedup        0.3 on 3 samples, 31 GiB of matrix, in a 12 GiB limit; sized by sample count
//   heat map                  2.0 to 6.2 below 1 GiB; a 25 GiB matrix ran in a 12 GiB limit; runs at slope 1
//   xsv import                2.0 to 5.7 below 1 GiB; 1.1 on a 25 GiB matrix in a 54 GiB grant; the matrix import runs at slope 3
//
// So each slope covers its step by 2.0x or more, except the matrix import, whose peak follows
// its grant (1.65x at slope 3). aggregate-variants has no slope; its bucket law grants 2.0x
// its need.

ll := import("@platforma-sdk/workflow-tengo:ll")
feats := import("@platforma-sdk/workflow-tengo:feats")
units := import("@platforma-sdk/workflow-tengo:units")
math := import("math")

FLOOR_GIB := 16

// Need of each sample-count-sized step: baseGiB + perSampleMiB x samples.
STEP_NEED := {
	dedup: { baseGiB: 4, perSampleMiB: 60 }
}

// fallbackGiB returns the flat grant on a backend without blob sizes.
fallbackGiB := func(aggMemGB) {
	if !is_undefined(aggMemGB) && aggMemGB > FLOOR_GIB {
		return int(math.ceil(aggMemGB))
	}
	return FLOOR_GIB
}

// apply puts `wf` on the heavy queue and sets its memory.
apply := func(wf, aggMemGB) {
	wf = wf.inHeavyQueue()
	if feats.hasBlobSize {
		return wf.memFloor(FLOOR_GIB * units.GiB)
	}
	return wf.mem(fallbackGiB(aggMemGB) * units.GiB)
}

// applyComputed puts `wf` on the heavy queue and requests `bytes`, an integer of at least 4 GiB.
// Slope 0 makes pt request max(memFloor, memIntercept) with or without blob sizes.
applyComputed := func(wf, bytes) {
	return wf.inHeavyQueue().memSlope(0).memIntercept(bytes)
}

// perSampleIntercept returns baseGiB + perSampleMiB x samples, in bytes, for .memIntercept().
// With .memSlope(0) the request then grows with the sample count instead of input bytes.
perSampleIntercept := func(baseGiB, perSampleMiB, samples) {
	return baseGiB * units.GiB + perSampleMiB * units.MiB * samples
}

// importMem returns the `mem` option of a variant-keyed xsv.importFile: undefined, which
// leaves the SDK's input-size rule in charge, or the flat grant on a backend without blob
// sizes.
importMem := func(aggMemGB) {
	if feats.hasBlobSize {
		return undefined
	}
	return fallbackGiB(aggMemGB) * units.GiB
}

// requestBytes returns max(FLOOR_GIB GiB, 2 x needBytes, ceil(settingGiB) GiB) as an integer.
// settingGiB may be undefined.
requestBytes := func(needBytes, settingGiB) {
	bytes := FLOOR_GIB * units.GiB
	doubled := 2 * needBytes
	if is_float(doubled) {
		doubled = int(math.ceil(doubled))
	}
	if doubled > bytes {
		bytes = doubled
	}
	if !is_undefined(settingGiB) {
		setting := int(math.ceil(settingGiB)) * units.GiB
		if setting > bytes {
			bytes = setting
		}
	}
	return bytes
}

// settingFor returns the "Memory for aggregation" setting on a backend without blob sizes,
// else undefined.
settingFor := func(aggMemGB) {
	if feats.hasBlobSize {
		return undefined
	}
	return aggMemGB
}

// stepNeedBytes returns the need of `step` (a STEP_NEED key) for `samples` samples, in bytes.
stepNeedBytes := func(step, samples) {
	need := STEP_NEED[step]
	ll.assert(!is_undefined(need), "no STEP_NEED entry for step %v", step)
	return perSampleIntercept(need.baseGiB, need.perSampleMiB, samples)
}

stepRequestBytes := func(step, samples, aggMemGB) {
	return requestBytes(stepNeedBytes(step, samples), settingFor(aggMemGB))
}

// applyStep puts `wf` on the heavy queue and requests the sized need of `step`.
applyStep := func(wf, step, samples, aggMemGB) {
	return applyComputed(wf, stepRequestBytes(step, samples, aggMemGB))
}

// importOpts returns the memory options of a sized xsv.importFile; no `mem` key, so the
// intercept is the request with or without blob sizes.
importOpts := func(step, samples, aggMemGB) {
	return { memSlope: 0, memIntercept: stepRequestBytes(step, samples, aggMemGB) }
}

export {
	FLOOR_GIB: FLOOR_GIB,
	STEP_NEED: STEP_NEED,
	fallbackGiB: fallbackGiB,
	apply: apply,
	applyComputed: applyComputed,
	perSampleIntercept: perSampleIntercept,
	importMem: importMem,
	requestBytes: requestBytes,
	settingFor: settingFor,
	stepNeedBytes: stepNeedBytes,
	applyStep: applyStep,
	importOpts: importOpts
}
