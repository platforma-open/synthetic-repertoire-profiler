// Cross-sample variant aggregation (ephemeral).
//
// Reads the per-sample resource maps (the nt/aa abundance parquets and the per-sample variant
// metadata parquets, keys and wide; see downstream.tpl) and emits:
//   ntProperties.tsv  [variantKey]      -> sequence, mutations, mutationCount, isProductive, totals
//   aaProperties.tsv  [variantKey(aa)]  -> + ntVariantCount
//   ntLabels.tsv / aaLabels.tsv  [variantKey] -> variantLabel
//   ntToAa.tsv    [aaKey, ntKey]     -> 1   (one aa → many nt)
//   parentNt.tsv  [parentId, ntKey]  -> 1   (one parent → many nt)
//   parentAa.tsv  [parentId, aaKey]  -> 1   (one parent → many aa)
//
// Key buckets: rows split into K buckets by the first 2 hex chars of the variant key (the aa
// key on the aa level), K a power of two from 1 to 256, chosen from the total input size. Each
// bucket runs one nt job and one aa job. Every per-key group is complete inside its bucket, so
// the bucket parts concatenate to the full tables.
//
// Each job reads every sample's file and filters it to its bucket right after the read. A
// file has one reader per job; a second reader of a file would make the engine buffer its
// rows for that reader. Each bucket job is planned by a template of its own (variant-bucket),
// so no template run grows with samples x buckets.
//
// Labels: a label ranks the variant's sequence hash among all hashes with the same 5-letter
// prefix, which spans key buckets. So the bucket jobs write (variantKey, _seqHash), and L label
// jobs per level, split by the first letter of the prefix, rank them in a second pass.
//
// A table with several parts is concatenated by one more job; a single part is returned as is.
// The nt property table is built only when `needNt` is set, and the nt label table and the two
// nt linker tables only when `exportNt` is; the skipped outputs are null resources. `exportNt`
// requires `needNt`.
//
// The "Memory for aggregation" setting (`aggMemGB`) raises the bucket, label and concat jobs
// only on a backend without blob sizes.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
smart := import("@platforma-sdk/workflow-tengo:smart")
feats := import("@platforma-sdk/workflow-tengo:feats")
aggSizing := import(":aggregate-sizing")
buckets := import(":aggregate-buckets")
variantAggregate := import(":variant-aggregate")
render := import("@platforma-sdk/workflow-tengo:render")
assets := import("@platforma-sdk/workflow-tengo:assets")

variantBucketTpl := assets.importTemplate(":variant-bucket")

self.defineOutputs("ntProperties", "aaProperties", "ntToAa", "parentNt", "parentAa", "ntLabels", "aaLabels")

self.awaitState("InputsLocked")
self.awaitState("ntAbundanceData", "ResourceReady")
self.awaitState("aaAbundanceData", "ResourceReady")
self.awaitState("ntKeysData", "ResourceReady")
self.awaitState("ntWideData", "ResourceReady")
self.awaitState("aaKeysData", "ResourceReady")
self.awaitState("aaWideData", "ResourceReady")

MAP_NAMES := ["ntab", "aaab", "ntk", "ntw", "aak", "aaw"]

self.body(func(inputs) {
	needNt := is_undefined(inputs.needNt) || inputs.needNt
	exportNt := is_undefined(inputs.exportNt) || inputs.exportNt
	ll.assert(!exportNt || needNt, "exportNt requires needNt")
	opts := {
		hasUmi: !is_undefined(inputs.hasUmi) && inputs.hasUmi,
		needNt: needNt,
		exportNt: exportNt,
		exportOnlyKnown: !is_undefined(inputs.exportOnlyKnown) && inputs.exportOnlyKnown,
		hasNtKnown: !is_undefined(inputs.hasNtKnown) && inputs.hasNtKnown,
		// Per-region sequence columns (nSeq<name>/aaSeq<name>); names come from main.
		ntRegionCols: is_undefined(inputs.ntRegionCols) ? [] : inputs.ntRegionCols,
		aaRegionCols: is_undefined(inputs.aaRegionCols) ? [] : inputs.aaRegionCols
	}

	rm := {
		ntab: inputs.ntAbundanceData.inputs(),
		aaab: inputs.aaAbundanceData.inputs(),
		ntk: inputs.ntKeysData.inputs(),
		ntw: inputs.ntWideData.inputs(),
		aak: inputs.aaKeysData.inputs(),
		aaw: inputs.aaWideData.inputs()
	}
	// Sample keys in one fixed order, so frame i of every map is the same sample.
	sampleKeys := maps.getKeys(rm.aaab)
	ll.assert(len(sampleKeys) > 0, "no samples to aggregate")

	totalBytes := undefined
	if feats.hasBlobSize {
		totalBytes = 0
		for name in MAP_NAMES {
			for sKey in sampleKeys {
				ll.assert(!is_undefined(rm[name][sKey]), "no %v file for sample %v", name, sKey)
				totalBytes += ll.getBlobSize(rm[name][sKey].getValue().id)
			}
		}
	}
	p := buckets.plan(totalBytes, len(sampleKeys), inputs.aggBuckets)
	ll.print("aggregate-variants plan: k=" + string(p.k) + " l=" + string(p.l) + " totalBytes=" + string(p.totalBytes))

	aggMemGB := aggSizing.settingFor(inputs.aggMemGB)
	bucketBytes := buckets.bucketJobBytes(len(sampleKeys), p.totalBytes, p.k, aggMemGB)
	flatBytes := buckets.flatJobBytes(aggMemGB)

	labelKeep := func(letters, catchAll) {
		return func(col) {
			return buckets.labelPredicate(pt, col, letters, catchAll)
		}
	}
	bucketJob := func(level, prefixes, catchAll) {
		return render.createEphemeral(variantBucketTpl, {
			level: level,
			prefixes: prefixes,
			catchAll: catchAll,
			requestBytes: bucketBytes,
			opts: opts,
			ntAbundanceData: inputs.ntAbundanceData,
			aaAbundanceData: inputs.aaAbundanceData,
			ntKeysData: inputs.ntKeysData,
			ntWideData: inputs.ntWideData,
			aaKeysData: inputs.aaKeysData,
			aaWideData: inputs.aaWideData
		})
	}

	parts := {
		ntProperties: [],
		aaProperties: [],
		ntToAa: [],
		parentNt: [],
		parentAa: [],
		ntLabelIn: [],
		aaLabelIn: []
	}
	for b, prefixes in buckets.keyBucketPrefixes(p.k) {
		if needNt {
			ntRun := bucketJob("nt", prefixes, b == 0)
			parts.ntProperties = append(parts.ntProperties, ntRun.output("properties"))
			if exportNt {
				parts.ntLabelIn = append(parts.ntLabelIn, ntRun.output("labelIn"))
				parts.parentNt = append(parts.parentNt, ntRun.output("parent"))
			}
		}
		aaRun := bucketJob("aa", prefixes, b == 0)
		parts.aaProperties = append(parts.aaProperties, aaRun.output("properties"))
		parts.aaLabelIn = append(parts.aaLabelIn, aaRun.output("labelIn"))
		parts.parentAa = append(parts.parentAa, aaRun.output("parent"))
		if exportNt {
			parts.ntToAa = append(parts.ntToAa, aaRun.output("ntToAa"))
		}
	}

	labelParts := func(labelInFiles) {
		files := []
		for l, letters in buckets.labelLetters(p.l) {
			wf := aggSizing.applyLabel(pt.workflow(), flatBytes, p.l)
			variantAggregate.addLabels(wf, labelInFiles, labelKeep(letters, l == 0))
			files = append(files, wf.run().getFile("labels.tsv"))
		}
		return files
	}

	combine := func(files) {
		if len(files) == 1 {
			return files[0]
		}
		wf := aggSizing.applyComputed(pt.workflow(), flatBytes)
		variantAggregate.addConcat(wf, files)
		return wf.run().getFile("out.tsv")
	}

	return {
		ntProperties: needNt ? combine(parts.ntProperties) : smart.createNullResource(),
		aaProperties: combine(parts.aaProperties),
		ntToAa: exportNt ? combine(parts.ntToAa) : smart.createNullResource(),
		parentNt: exportNt ? combine(parts.parentNt) : smart.createNullResource(),
		parentAa: combine(parts.parentAa),
		ntLabels: exportNt ? combine(labelParts(parts.ntLabelIn)) : smart.createNullResource(),
		aaLabels: combine(labelParts(parts.aaLabelIn))
	}
})
