// Cross-sample variant aggregation (ephemeral).
//
// Reads the per-sample resource maps — nt/aa abundance parquets (for totals) and
// the raw variants/aa-variants TSVs (for sample-independent metadata) — and emits
// per-variant property tables:
//   ntProperties.tsv  [variantKey]      -> label, sequence, mutations, mutationCount, isProductive, totals
//   aaProperties.tsv  [variantKey(aa)]  -> + ntVariantCount
//
// Keys are mitool's content hashes (variantKey / aaVariantKey); the aa key is
// aliased to "variantKey" so both levels share the variant-axis column name. The
// display LABEL is V-XXXXX(-N), derived cross-sample from a hash of the variant's
// own sequence. mitool's `mutations` (colon-separated milib designator, on 1-based
// positions — the same axis as the state matrix) and `mutationCount` are carried as
// columns.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
aggSizing := import(":aggregate-sizing")

variantLabel := import(":variant-label")

self.defineOutputs("ntProperties", "aaProperties")

self.awaitState("InputsLocked")
self.awaitState("ntAbundanceData", "ResourceReady")
self.awaitState("aaAbundanceData", "ResourceReady")
self.awaitState("variantsTsvData", "ResourceReady")
self.awaitState("aaVariantsTsvData", "ResourceReady")

self.body(func(inputs) {
	wf := aggSizing.apply(pt.workflow(), inputs.aggMemGB)

	// TSV reads disable per-file type inference (`inferSchema: false` → every
	// column read as String). Per-sample TSVs vary: an empty one (header only)
	// infers every column as String, while a populated one infers numeric
	// columns (mutationCount, ntVariantCount, readCount, ...) as Int64, so the
	// cross-sample concat below rejects the schema mismatch. Reading all columns
	// as String makes every frame's schema identical; the aggregations below cast
	// each numeric column they consume, so the emitted types are unchanged.
	// Parquet keeps its embedded schema (inferSchema is not applicable / not set).
	loadFrames := func(rmData, idPrefix, format) {
		frames := []
		rmMap := rmData.inputs()
		for sKey in maps.getKeys(rmMap) {
			opts := { id: idPrefix + "_" + string(len(frames)) }
			if format == "tsv" {
				opts.inferSchema = false
			}
			frames = append(frames, wf.frame({
				file: rmMap[sKey],
				xsvType: format
			}, opts))
		}
		ll.assert(len(frames) > 0, "no frames for " + idPrefix)
		return frames
	}
	concatF := func(frames) {
		if len(frames) == 1 {
			return frames[0]
		}
		return pt.concat(frames)
	}

	// Cross-sample totals from the per-sample abundance parquets ([variantKey,
	// readCount, readFraction], one row per variantKey per sample).
	// The per-sample parquets carry the molecule columns only on a UMI run.
	hasUmi := !is_undefined(inputs.hasUmi) && inputs.hasUmi
	totals := func(frames) {
		aggs := [
			pt.col("readCount").cast("Long").sum().alias("readCountTotal"),
			pt.col("readFraction").cast("Double").mean().alias("readFractionMean"),
			pt.col("readCount").count().alias("sampleCount")
		]
		if hasUmi {
			aggs = append(aggs,
				pt.col("uniqueMoleculeCount").cast("Long").sum().alias("uniqueMoleculeCountSum"),
				pt.col("uniqueMoleculeFraction").cast("Double").mean().alias("uniqueMoleculeFractionMean")
			)
		}
		return concatF(frames).groupBy("variantKey").agg(aggs...)
	}

	withLabel := func(df) {
		return variantLabel.addVariantLabelColumnsPt(
			df.withColumns(
				pt.col("sequence").hash("sha256", "base64_alphanumeric", 120).alias("_seqHash")
			),
			"_seqHash",
			"variantLabel",
			pt
		)
	}

	// Per-region sequence columns (nSeq<name>/aaSeq<name>) carried through when the
	// run defines regions. Names come from main (parsed from the regions overlay).
	ntRegionCols := is_undefined(inputs.ntRegionCols) ? [] : inputs.ntRegionCols
	aaRegionCols := is_undefined(inputs.aaRegionCols) ? [] : inputs.aaRegionCols

	// Productive = no frame shift and no stop codon in the translation, as "true" /
	// "false" strings (the MiXCR blocks' convention). An aa variant is productive when
	// its sequence carries no `*`. An nt variant is productive when no sample calls it
	// frame-shifted and the aa variant it translates to is productive. The frame-shift
	// call can differ between samples (AA_MISMATCH looks at the sample's other
	// synonymous members), so any one sample calling it is enough. Both are folded
	// into the one group-by per level: ptabler's group-by keeps order and cannot
	// stream, so each extra one holds another table of every distinct variant.
	productiveIf := func(cond) {
		return pt.when(cond).then(pt.lit("true")).otherwise(pt.lit("false"))
	}

	// --- aa level, grouped first: the nt level reads its isProductive ---
	// Metadata keyed by aaVariantKey, aliased to variantKey on output.
	aaAggs := [
		pt.col("aaSequence").first().alias("sequence"),
		pt.col("mutations").cast("String").first().alias("mutations"),
		pt.col("mutationCount").cast("Int").first().alias("mutationCount")
	]
	aaMetaSelect := [
		pt.col("aaVariantKey").alias("variantKey"),
		pt.col("sequence"),
		pt.col("mutations"),
		pt.col("mutationCount"),
		pt.col("isProductive"),
		pt.col("ntVariantCount")
	]
	aaSelect := [
		pt.col("variantKey"),
		pt.col("variantLabel"),
		pt.col("sequence"),
		pt.col("mutations"),
		pt.col("mutationCount"),
		pt.col("isProductive"),
		pt.col("readCountTotal"),
		pt.col("readFractionMean"),
		pt.col("sampleCount"),
		pt.col("ntVariantCount")
	]
	if hasUmi {
		aaSelect = append(aaSelect, pt.col("uniqueMoleculeCountSum"), pt.col("uniqueMoleculeFractionMean"))
	}
	for rn in aaRegionCols {
		aaAggs = append(aaAggs, pt.col("aaSeq" + rn).cast("String").first().alias("aaSeq" + rn))
		aaMetaSelect = append(aaMetaSelect, pt.col("aaSeq" + rn))
		aaSelect = append(aaSelect, pt.col("aaSeq" + rn))
	}
	aaGrouped := concatF(loadFrames(inputs.aaVariantsTsvData, "aav", "tsv")).
		groupBy("aaVariantKey").agg(aaAggs...).
		withColumns(
			productiveIf(pt.col("sequence").strContains("*", { literal: true }).not()).alias("isProductive")
		)

	// --- nt level ---
	ntAggs := [
		pt.col("ntSequence").first().alias("sequence"),
		pt.col("mutations").cast("String").first().alias("mutations"),
		pt.col("mutationCount").cast("Int").first().alias("mutationCount"),
		// A frame-shifted sample leaves the aa key empty; max() takes the real one.
		pt.col("aaVariantKey").cast("String").max().alias("aaVariantKey"),
		pt.when(pt.col("frameShift").strToUpper().eq("TRUE")).
			then(pt.lit(1)).otherwise(pt.lit(0)).max().alias("_frameShift")
	]
	ntSelect := [
		pt.col("variantKey"),
		pt.col("variantLabel"),
		pt.col("sequence"),
		pt.col("mutations"),
		pt.col("mutationCount"),
		pt.col("isProductive"),
		pt.col("readCountTotal"),
		pt.col("readFractionMean"),
		pt.col("sampleCount")
	]
	if hasUmi {
		ntSelect = append(ntSelect, pt.col("uniqueMoleculeCountSum"), pt.col("uniqueMoleculeFractionMean"))
	}
	for rn in ntRegionCols {
		ntAggs = append(ntAggs, pt.col("nSeq" + rn).cast("String").first().alias("nSeq" + rn))
		ntSelect = append(ntSelect, pt.col("nSeq" + rn))
	}
	ntVariants := concatF(loadFrames(inputs.variantsTsvData, "ntv", "tsv"))
	ntMeta := ntVariants.groupBy("variantKey").agg(ntAggs...).
		join(
			aaGrouped.select(pt.col("aaVariantKey"), pt.col("isProductive").alias("_aaProductive")),
			{ how: "left", on: ["aaVariantKey"] }
		).
		withColumns(
			productiveIf(
				pt.col("_frameShift").eq(pt.lit(0)).and(pt.col("_aaProductive").fillNull("false").eq(pt.lit("true")))
			).alias("isProductive")
		)
	withLabel(
		totals(loadFrames(inputs.ntAbundanceData, "ntab", "parquet")).
			join(ntMeta, { how: "left", on: ["variantKey"] })
	).select(ntSelect...).sort(["variantKey"]).save("ntProperties.tsv", { xsvType: "tsv" })

	// Synonymous-replicate count: distinct nt variants encoding this aa variant, over
	// the whole dataset. Recounted here — the TSV's own ntVariantCount is mitool's
	// per-sample count, and no cross-sample aggregation of it is right (first() takes
	// one sample's subset, sum() double-counts a shared variant, max() misses variants
	// only other samples carry). Same set as the ntToAa linker in aggregate-linkers,
	// frame-shifted nt variants excluded the same way (they carry no aa key).
	ntPerAa := ntVariants.
		filter(pt.col("aaVariantKey").cast("String").fillNull("").strLenChars().gt(pt.lit(0))).
		groupBy("aaVariantKey").
		agg(pt.col("variantKey").nUnique().alias("ntVariantCount"))
	aaMeta := aaGrouped.
		join(ntPerAa, { how: "left", on: ["aaVariantKey"] }).
		select(aaMetaSelect...)
	withLabel(
		totals(loadFrames(inputs.aaAbundanceData, "aaab", "parquet")).
			join(aaMeta, { how: "left", on: ["variantKey"] })
	).select(aaSelect...).sort(["variantKey"]).save("aaProperties.tsv", { xsvType: "tsv" })

	result := wf.run()

	return {
		ntProperties: result.getFile("ntProperties.tsv"),
		aaProperties: result.getFile("aaProperties.tsv")
	}
})
