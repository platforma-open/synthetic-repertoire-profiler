// Second stage of the cross-sample state-matrix dedup (ephemeral); see aggregate-state-matrix.
//
// `owners` holds one parquet per key bucket, [variantKey, parentId] -> __owner, the index of
// the pair's owner sample in the sorted sample keys. The matrix rows stream through the join;
// the job holds the owner rows, one per distinct pair, so it is sized from the owner files.
//
// (mitool names the first TSV column `variantKey` in both the aa and nt exports; it holds the
// aa/nt variant key respectively, matching the variant axis column.)
// No trailing sort: xsv.importFile sorts by axes.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
feats := import("@platforma-sdk/workflow-tengo:feats")
aggSizing := import(":aggregate-sizing")

self.defineOutputs("stateMatrix")

self.awaitState("InputsLocked")
self.awaitState("stateMatrixData", "ResourceReady")
self.awaitState("owners", "ResourceReady")
self.awaitState("owners", { wildcard: "*" }, "ResourceReady")

self.body(func(inputs) {
	smMap := inputs.stateMatrixData.inputs()
	// A map resource arrives as a plain map of its values.
	ownMap := inputs.owners
	sampleKeys := maps.getKeys(smMap)
	bucketKeys := maps.getKeys(ownMap)
	ll.assert(len(sampleKeys) > 0, "no state-matrix frames")
	ll.assert(len(bucketKeys) > 0, "no owner files")

	ownerBytes := undefined
	if feats.hasBlobSize {
		ownerBytes = 0
		for bKey in bucketKeys {
			ownerBytes += ll.getBlobSize(ownMap[bKey].id)
		}
	}
	wf := aggSizing.applyComputed(pt.workflow().name("ptabler state matrix join"),
		aggSizing.matrixJoinRequestBytes(len(sampleKeys), ownerBytes, inputs.aggMemGB))

	ownFrames := []
	for bKey in bucketKeys {
		ownFrames = append(ownFrames, wf.frame({
			file: ownMap[bKey],
			xsvType: "parquet"
		}, { id: "own_" + bKey }))
	}
	owners := len(ownFrames) > 1 ? pt.concat(ownFrames) : ownFrames[0]

	smFrames := []
	for idx, sKey in sampleKeys {
		// inferSchema:false -> every column String, so empty and populated per-sample
		// TSVs share one schema and the concat cannot hit a type mismatch.
		smFrames = append(smFrames, wf.frame({
			file: smMap[sKey],
			xsvType: "tsv"
		}, { id: "sm_" + string(idx), inferSchema: false }).withColumns(
			pt.lit(idx).alias("__owner")
		))
	}
	matrix := len(smFrames) > 1 ? pt.concat(smFrames) : smFrames[0]

	matrix.
		join(owners, { how: "inner", on: ["variantKey", "parentId", "__owner"] }).
		select(pt.col("variantKey"), pt.col("parentId"), pt.col("position"), pt.col("state")).
		save("stateMatrix.parquet")

	return {
		stateMatrix: wf.run().getFile("stateMatrix.parquet")
	}
})
