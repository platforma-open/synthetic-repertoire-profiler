// Derives the region feature names from the `--parent-regions` overlay JSON, so
// the workflow declares sequence-import columns that match what mitool emits.
// The same JSON mitool consumes is parsed here — one source of truth.

maps := import("@platforma-sdk/workflow-tengo:maps")
json := import("json")

// analyze(parentRegionsJson) ->
//   enabled         : a scheme is configured for at least one parent
//   hasRegions      : at least one parent has a non-empty region partition
//   hasSubRegions   : at least one region is subdivided — gates the second membership
//                     column, so a run without grafts is byte-identical to before
//   subdividedByParent : parentId -> the names of parent regions that hold
//                     sub-regions. Only parents with at least one appear.
//   isVdj           : at least one parent uses the canonical `vdj` region scheme —
//                     the run's modality declaration is derived from this
//   ntRegionNames   : union of named-region names (first-seen order)
//   aaRegionNames   : those codon-aligned at frame 0 (begin%3==0 && end%3==0)
//   completeFeatureName : the complete-feature name if a single one is used, else undefined
analyze := func(parentRegionsJson) {
	res := {
		enabled: false,
		hasRegions: false,
		hasSubRegions: false,
		// Whether the per-parent "Subdivided regions" column is worth emitting. True for a
		// user-defined partition (a graft in a CDR slot). False for the scFv path, where every
		// V-domain is mechanically split into FR/CDR — listing it would be uniform noise — even
		// though hasSubRegions stays true so the heat map keeps its sub-region band.
		showSubdividedRegions: false,
		subdividedByParent: {},
		isVdj: false,
		ntRegionNames: [],
		aaRegionNames: [],
		completeFeatureName: undefined
	}
	if is_undefined(parentRegionsJson) || parentRegionsJson == "" {
		return res
	}

	parents := json.decode(parentRegionsJson).parents
	if is_undefined(parents) {
		return res
	}
	res.enabled = true

	ntSeen := {}
	aaSeen := {}
	afSet := {}
	for pid in maps.getKeys(parents) {
		ps := parents[pid]
		// One parent on the vdj scheme makes the whole run vdj: a run has exactly
		// one modality, and choosing that scheme is the user stating V-domain work.
		if ps.scheme == "vdj" {
			res.isVdj = true
		}
		if !is_undefined(ps.completeFeatureName) && ps.completeFeatureName != "" {
			afSet[ps.completeFeatureName] = true
		}
		regions := ps.regions
		if is_undefined(regions) {
			regions = []
		}
		if len(regions) > 0 {
			res.hasRegions = true
		}
		for r in regions {
			// A subdivided region contributes its own span AND each sub-region's: every one
			// is an ordinary span downstream, with its own sequence column. Container first,
			// then its children, which is the order mitool flattens them into.
			spans := [r]
			kids := r.children
			if !is_undefined(kids) && len(kids) > 0 {
				res.hasSubRegions = true
				// A graft in the overlay is a user-defined partition, so it is worth listing.
				res.showSubdividedRegions = true
				held := res.subdividedByParent[pid]
				if is_undefined(held) {
					held = []
				}
				res.subdividedByParent[pid] = append(held, r.name)
				for c in kids {
					spans = append(spans, c)
				}
			}
			for sp in spans {
				// An ignored span is masked to the parent, so mitool emits no sequence column for
				// it — the import must not reference one. mitool still lists it in region-annotation.
				if sp.ignored == true {
					continue
				}
				name := sp.name
				if is_undefined(ntSeen[name]) {
					ntSeen[name] = true
					res.ntRegionNames = append(res.ntRegionNames, name)
				}
				// Codon alignment is a property of each span on its own: a container may be
				// aa-eligible while one of its sub-regions is not, or the other way round.
				if int(sp.begin) % 3 == 0 && int(sp.end) % 3 == 0 && is_undefined(aaSeen[name]) {
					aaSeen[name] = true
					res.aaRegionNames = append(res.aaRegionNames, name)
				}
			}
		}
	}

	afNames := maps.getKeys(afSet)
	if len(afNames) == 1 {
		res.completeFeatureName = afNames[0]
	}
	return res
}

// Static region config for whole-dataset vdjAutoDetect: every parent is a VDJ
// V-domain with the canonical FR1–FR4 partition + VDJRegion whole-variant feature.
// Region NAMES are fixed; the offsets are computed by the workflow (repseqio) and
// live only in the mitool overlay file. All seven regions are declared aa-eligible
// — the assemble step guarantees they are codon-aligned (else it fails), so mitool
// emits every aaSeq{region} column and the import never references a missing one.
vdjAuto := func() {
	names := ["FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"]
	return {
		enabled: true,
		hasRegions: true,
		// Germline-inferred boundaries are the seven canonical regions and nothing below.
		hasSubRegions: false,
		showSubdividedRegions: false,
		subdividedByParent: {},
		isVdj: true,
		ntRegionNames: names,
		aaRegionNames: names,
		completeFeatureName: "VDJRegion"
	}
}

// The seven canonical FR/CDR names germline auto-detect splits a V-domain into. The model
// (buildRegionChains) and the python `assemble` step expand the same list with the same
// `<domain>_<name>` prefix, so the column names, their chain tags and the overlay all agree.
CANONICAL_VDJ_REGIONS := ["FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"]

// Static region config for per-domain scFv auto-detect. The overlay is built at run time
// (repseqio), so the names are derived here from the drawn scheme instead — the same source
// the model and python read. Each auto-detect domain becomes a container region (the
// whole-domain VH / VL sequence column) holding its seven prefixed FR/CDR children (all
// aa-eligible: assemble guarantees codon alignment or fails). The container makes the run
// subdivided, so a non-scheme run stays byte-identical. A non-auto region passes through by
// name (aa-eligible only when codon-aligned). Ignored regions carry no column. No single
// complete feature — an scFv spans two chains.
scfvAuto := func(autoSchemeJson) {
	parents := json.decode(autoSchemeJson).parents
	res := {
		enabled: true,
		hasRegions: true,
		hasSubRegions: false,
		// The containers subdivide, but it is the uniform V-domain -> FR/CDR split, so the
		// per-parent "Subdivided regions" column stays off while the heat map keeps its band.
		showSubdividedRegions: false,
		subdividedByParent: {},
		isVdj: true,
		ntRegionNames: [],
		aaRegionNames: [],
		completeFeatureName: undefined
	}
	ntSeen := {}
	aaSeen := {}
	addName := func(name, aaEligible) {
		if is_undefined(ntSeen[name]) {
			ntSeen[name] = true
			res.ntRegionNames = append(res.ntRegionNames, name)
		}
		if aaEligible && is_undefined(aaSeen[name]) {
			aaSeen[name] = true
			res.aaRegionNames = append(res.aaRegionNames, name)
		}
	}
	for pid in maps.getKeys(parents) {
		regions := parents[pid].regions
		if is_undefined(regions) {
			regions = []
		}
		for r in regions {
			if r.autoDetect == true {
				// Container first (matches mitool's flatten order), then its FR/CDR children.
				addName(r.name, true)
				res.hasSubRegions = true
				held := res.subdividedByParent[pid]
				if is_undefined(held) {
					held = []
				}
				res.subdividedByParent[pid] = append(held, r.name)
				for canonical in CANONICAL_VDJ_REGIONS {
					addName(r.name + "_" + canonical, true)
				}
			} else if r.ignored == true {
				continue
			} else {
				// A manual region contributes its own column and, when grafted, each sub-region's —
				// dropping the children would leave the import without their columns.
				addName(r.name, int(r.begin) % 3 == 0 && int(r.end) % 3 == 0)
				kids := r.children
				if !is_undefined(kids) && len(kids) > 0 {
					res.hasSubRegions = true
					res.showSubdividedRegions = true
					held := res.subdividedByParent[pid]
					if is_undefined(held) {
						held = []
					}
					res.subdividedByParent[pid] = append(held, r.name)
					for c in kids {
						if c.ignored == true {
							continue
						}
						addName(c.name, int(c.begin) % 3 == 0 && int(c.end) % 3 == 0)
					}
				}
			}
		}
	}
	return res
}

export {
	analyze: analyze,
	vdjAuto: vdjAuto,
	scfvAuto: scfvAuto
}
