// Known-set overlay aggregation (ephemeral), only when a known set is given.
//
// Assignment runs at budget 0 (exact match), so an ASSIGNED variant's own sequence is the
// matched known sequence, and the known-variant key is the hash of that sequence.
//
//   knownLinkerNt.parquet / knownLinkerAa.parquet  [knownVariantKey, variantKey] -> 1
//   ntDistance.parquet / aaDistance.parquet        [variantKey] -> mutations to the nearest known entry
//   knownNt.parquet / knownAa.parquet              [knownVariantKey] -> id, sequence, totals over samples
//   knownNtAll.parquet                         every designed nt entry, totals where detected
//   knownAaToNt.parquet, knownSynCount.parquet     from the designed tables
//   knownConvergence.parquet                   [knownVariantKey(aa)] -> mean synonymous spread
//
// No job holds rows in proportion to the sample count times a table's rows. Three kinds of job:
//
// The bucket jobs are one template each (known-bucket).
//
//   variant-key jobs   per level, K buckets on the variant key: read every sample's known-keys
//                      file (downstream.tpl; no sequence column) and write the bucket's
//                      (known key, variant key, id) links and its distance rows.
//   known-key jobs     K buckets on the known key: sum the per-sample known abundance tables
//                      into totals, and average the per-sample convergence tables, after an
//                      inner join with the bucket's matched aa keys (one file, from the aa
//                      finish job).
//   finish jobs        finish-known.tpl, one per level: hold the links and totals, one row per
//                      matched variant, and take each sequence from the property table of the
//                      variant aggregate.
//
// Every group is keyed by its job's bucket key, so the bucket parts concatenate to the full
// tables. The nt jobs run only with an nt known set; their outputs are null resources without.
// No trailing sort: xsv.importFile sorts by axes.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
smart := import("@platforma-sdk/workflow-tengo:smart")
render := import("@platforma-sdk/workflow-tengo:render")
assets := import("@platforma-sdk/workflow-tengo:assets")
feats := import("@platforma-sdk/workflow-tengo:feats")
units := import("@platforma-sdk/workflow-tengo:units")
aggSizing := import(":aggregate-sizing")
buckets := import(":aggregate-buckets")
variantAggregate := import(":variant-aggregate")

finishKnownTpl := assets.importTemplate(":finish-known")
knownBucketTpl := assets.importTemplate(":known-bucket")

self.defineOutputs("knownLinkerNt", "knownLinkerAa", "ntDistance", "aaDistance", "knownNt", "knownAa", "knownAaToNt", "knownSynCount", "knownConvergence", "knownNtAll")

self.awaitState("InputsLocked")
self.awaitState("ntKnownKeysData", "ResourceReady")
self.awaitState("aaKnownKeysData", "ResourceReady")
self.awaitState("knownNtAbundanceData", "ResourceReady")
self.awaitState("knownAaAbundanceData", "ResourceReady")
self.awaitState("aaConvergenceData", "ResourceReady")
self.awaitState("knownDesignedNtData", "ResourceReady")
self.awaitState("knownDesignedAaData", "ResourceReady")

// Bytes per sample assumed on a backend without blob sizes: 1M designed entries, 0.4M variants
// per sample.
EST_KEYS_SAMPLE_BYTES := 6 * units.MiB
EST_TOTALS_SAMPLE_BYTES := 7 * units.MiB
EST_CONVERGENCE_SAMPLE_BYTES := 14 * units.MiB

self.body(func(inputs) {
	hasNtKnown := !is_undefined(inputs.hasNtKnown) && inputs.hasNtKnown
	// Under export-only-matched the distance tables keep only the matched variants, the ones
	// the export keeps.
	exportOnlyKnown := !is_undefined(inputs.exportOnlyKnown) && inputs.exportOnlyKnown
	hasUmi := !is_undefined(inputs.hasUmi) && inputs.hasUmi
	aggMemGB := aggSizing.settingFor(inputs.aggMemGB)

	rm := {
		ntKeys: inputs.ntKnownKeysData.inputs(),
		aaKeys: inputs.aaKnownKeysData.inputs(),
		ntTotals: inputs.knownNtAbundanceData.inputs(),
		aaTotals: inputs.knownAaAbundanceData.inputs(),
		convergence: inputs.aaConvergenceData.inputs(),
		designedNt: inputs.knownDesignedNtData.inputs(),
		designedAa: inputs.knownDesignedAaData.inputs()
	}
	sampleKeys := maps.getKeys(rm.aaKeys)
	samples := len(sampleKeys)
	ll.assert(samples > 0, "no samples to aggregate")

	// planFor chooses the bucket count of the jobs reading the per-sample map `name`.
	planFor := func(name, estSampleBytes) {
		totalBytes := undefined
		if feats.hasBlobSize {
			totalBytes = 0
			for sKey in sampleKeys {
				ll.assert(!is_undefined(rm[name][sKey]), "no %v file for sample %v", name, sKey)
				totalBytes += ll.getBlobSize(rm[name][sKey].getValue().id)
			}
		}
		p := buckets.plan(totalBytes, samples, inputs.aggBuckets, estSampleBytes)
		ll.print("aggregate-known plan: " + name + " k=" + string(p.k) + " totalBytes=" + string(p.totalBytes))
		return p
	}

	combine := func(files) {
		if len(files) == 1 {
			return files[0]
		}
		wf := aggSizing.applyComputed(pt.workflow(), buckets.flatJobBytes(aggMemGB))
		variantAggregate.addConcat(wf, files)
		return wf.run().getFile("out.parquet")
	}

	// One template per bucket job; see known-bucket.
	data := {
		ntKeys: inputs.ntKnownKeysData,
		aaKeys: inputs.aaKnownKeysData,
		ntTotals: inputs.knownNtAbundanceData,
		aaTotals: inputs.knownAaAbundanceData,
		convergence: inputs.aaConvergenceData
	}

	// variantKeyJobs runs the variant-key jobs of one level. `matchedBy` names how a row shows
	// that it carries a known key; `distanceCol` holds the distance.
	variantKeyJobs := func(name, keyCol, idCol, matchedBy, distanceCol) {
		p := planFor(name, EST_KEYS_SAMPLE_BYTES)
		request := buckets.bucketJobBytes(samples, p.totalBytes, p.k, aggMemGB)
		links := {}
		distances := []
		for b, prefixes in buckets.keyBucketPrefixes(p.k) {
			run := render.createEphemeral(knownBucketTpl, {
				kind: "links",
				data: data[name],
				requestBytes: request,
				prefixes: prefixes,
				catchAll: b == 0,
				keyCol: keyCol,
				idCol: idCol,
				matchedBy: matchedBy,
				distanceCol: distanceCol,
				exportOnlyKnown: exportOnlyKnown
			})
			links[buckets.bucketName(b)] = run.output("links")
			distances = append(distances, run.output("distance"))
		}
		return { links: links, distance: combine(distances) }
	}

	// knownKeyJobs runs one job of `kind` per known-key bucket of the per-sample map `name` and
	// returns the output of every job, by bucket name.
	knownKeyJobs := func(name, estSampleBytes, kind, extra) {
		p := planFor(name, estSampleBytes)
		share := buckets.knownKeyShare(p.k)
		request := buckets.shareJobBytes(samples, p.totalBytes, share.num, share.den, aggMemGB)
		files := {}
		for b, bucket in buckets.knownKeyBuckets(p.k) {
			jobInputs := {
				kind: kind,
				data: data[name],
				requestBytes: request,
				first: bucket.first,
				catchAll: b == 0
			}
			if !is_undefined(bucket.second) {
				jobInputs.second = bucket.second
			}
			for k, v in extra {
				jobInputs[k] = v
			}
			files[buckets.bucketName(b)] = render.createEphemeral(knownBucketTpl, jobInputs).output("out")
		}
		return files
	}

	// Totals of one level over the samples.
	totalsJobs := func(name) {
		return knownKeyJobs(name, EST_TOTALS_SAMPLE_BYTES, "totals", { hasUmi: hasUmi })
	}

	finish := func(level, keys, totals, sequenceFile, sequenceFrom) {
		return render.createEphemeral(finishKnownTpl, {
			level: level,
			aggMemGB: inputs.aggMemGB,
			hasUmi: hasUmi,
			links: smart.createMapResource(keys.links),
			totals: smart.createMapResource(totals),
			sequenceFile: sequenceFile,
			sequenceFrom: sequenceFrom,
			// The designed tables are the same in every sample, so one sample's copy is read.
			designedNt: rm.designedNt[sampleKeys[0]],
			designedAa: rm.designedAa[sampleKeys[0]]
		})
	}

	aaKeys := variantKeyJobs("aaKeys", "aaVariantKey", "knownAaKey", "id", "aaMutationsToKnown")
	aaFinish := finish("aa", aaKeys, totalsJobs("aaTotals"), inputs.aaProperties, "properties")

	// Mean synonymous spread per known aa over the samples, for the matched known aa only.
	convergence := knownKeyJobs("convergence", EST_CONVERGENCE_SAMPLE_BYTES, "convergence", {
		matchedKeys: aaFinish.output("matchedKeys")
	})

	result := {
		knownLinkerAa: aaFinish.output("linker"),
		aaDistance: aaKeys.distance,
		knownAa: aaFinish.output("known"),
		knownAaToNt: aaFinish.output("knownAaToNt"),
		knownSynCount: aaFinish.output("knownSynCount"),
		knownConvergence: combine(maps.getValues(convergence)),
		knownLinkerNt: smart.createNullResource(),
		ntDistance: smart.createNullResource(),
		knownNt: smart.createNullResource(),
		knownNtAll: smart.createNullResource()
	}
	if hasNtKnown {
		ntKeys := variantKeyJobs("ntKeys", "variantKey", "knownNtKey", "assignStatus", "nMutationsToKnown")
		// Without the nt property table the nt sequence comes from the designed table: at
		// budget 0 a detected entry's sequence is its designed one.
		needNt := !is_undefined(inputs.needNt) && inputs.needNt
		ntFinish := finish("nt", ntKeys, totalsJobs("ntTotals"),
			needNt ? inputs.ntProperties : rm.designedNt[sampleKeys[0]],
			needNt ? "properties" : "designed")
		result.knownLinkerNt = ntFinish.output("linker")
		result.ntDistance = ntKeys.distance
		result.knownNt = ntFinish.output("known")
		result.knownNtAll = ntFinish.output("knownNtAll")
	}
	return result
})
